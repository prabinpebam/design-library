{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/heroui/content/1",
  "title": "Component library in HeroUI v3's look content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/heroui/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "HerouiCategory": {
      "additionalProperties": false,
      "description": "A category of components (Buttons, Forms, Pickers…): its in-page anchor, title, one line and its previews.",
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/$defs/HerouiExample"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "examples"
      ],
      "type": "object"
    },
    "HerouiDemo": {
      "description": "One demo the showcase knows how to draw; each is built from core components only.",
      "enum": [
        "button",
        "button-sizes",
        "button-group",
        "toggle-button-group",
        "text-field",
        "field-states",
        "number-field",
        "textarea",
        "checkbox",
        "radio-group",
        "select",
        "combo-box",
        "switch",
        "slider",
        "date-picker",
        "date-time-fields",
        "calendar",
        "dropdown",
        "tag-group",
        "avatar",
        "chip-and-badge",
        "kbd-and-typography",
        "color-picker",
        "alert",
        "progress",
        "skeleton",
        "tabs",
        "accordion",
        "breadcrumbs-and-pagination",
        "modal",
        "drawer",
        "popover-and-tooltip",
        "toast",
        "table",
        "card",
        "empty-state"
      ],
      "type": "string"
    },
    "HerouiExample": {
      "additionalProperties": false,
      "description": "One component's preview: what it is and the demo that shows its variants and states.",
      "properties": {
        "demo": {
          "$ref": "#/$defs/HerouiDemo"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "demo",
        "title",
        "description"
      ],
      "type": "object"
    },
    "HerouiGroup": {
      "additionalProperties": false,
      "description": "A kind of component (fundamentals or compounds) and its categories.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/HerouiCategory"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "categories"
      ],
      "type": "object"
    },
    "HerouiRecord": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/HerouiGroup"
          },
          "type": "array"
        },
        "home": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "page": {
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "string"
            },
            "navLabel": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "lead",
            "navLabel"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ],
          "type": "object"
        },
        "words": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The words inside the demos, by key.",
          "type": "object"
        }
      },
      "required": [
        "name",
        "home",
        "source",
        "page",
        "groups",
        "words"
      ],
      "type": "object"
    },
    "record.shared": {
      "$ref": "#/$defs/HerouiRecord"
    }
  }
}
