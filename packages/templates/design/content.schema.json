      ],
      "type": "string"
    },
    "InspectorFact": {
      "additionalProperties": false,
      "description": "A computed reading in the Dev tab: a label and the property it shows.",
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "key"
      ],
      "type": "object"
    },
    "InspectorField": {
      "additionalProperties": false,
      "description": "One control of the inspector (Q66.3), drawn by the library component its `kind` names: number → NumberField, select → Select, segmented → SegmentedControl, switch → Switch, colour → TextField with the ColourPicker swatch, slider → Slider, text → TextField, alignment → AlignmentPicker, gradient → GradientEditor, align → the buttons that move the layer inside its frame, column → its `fields` stacked in one cell (the spacing beside the auto-layout alignment grid, as Figma), menu → an icon-only MenuButton whose name says the current choice. `key` is the property it reads and writes (`x`, `y`, `width`, `height` and `text` are the layer's own; the rest are its props); a number's `also` keys are written with it (one horizontal padding sets left and right), and it reads Mixed when they differ. `when` may list several conditions; all must hold.",
      "properties": {
        "also": {
          "description": "More keys a number writes with `key`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "at": {
          "const": "action",
          "description": "`action`: drawn in the row's action column, after the fields (a stroke's sides menu).",
          "type": "string"
        },
        "fields": {
          "description": "A column's fields, stacked.",
          "items": {
            "$ref": "#/$defs/InspectorField"
          },
          "type": "array"
        },
        "glyph": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "iconOnly": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "number",
            "select",
            "segmented",
            "switch",
            "checkbox",
            "visibility",
            "colour",
            "slider",
            "text",
            "alignment",
            "gradient",
            "align",
            "column",
            "menu"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/InspectorOption"
          },
          "type": "array"
        },
        "placeholder": {
          "description": "A text field's hint while empty (an export's \"Suffix\").",
          "type": "string"
        },
        "step": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/InspectorWhen"
            },
            {
              "items": {
                "$ref": "#/$defs/InspectorWhen"
              },
              "type": "array"
            }
          ]
        },
        "wide": {
          "description": "Takes two thirds of a two-field row (a stroke's position beside its weight).",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "kind",
        "label"
      ],
      "type": "object"
    },
    "InspectorList": {
      "additionalProperties": false,
      "description": "A list of like items in one section: fills, strokes, effects, layout grids, exports, interactions.",
      "properties": {
        "add": {
          "description": "The add button's name: \"Add fill\".",
          "type": "string"
        },
        "item": {
          "description": "One item's name; {n} is its number: \"Fill {n}\".",
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "remove": {
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/InspectorField"
            },
            "type": "array"
          },
          "type": "array"
        },
        "show": {
          "type": "string"
        },
        "summary": {
          "description": "Each item as one row naming it, e.g. \"{trigger} → {destination}\" (each key filled with its chosen option's label); its button opens the fields, labelled, in a Popover (Figma's interactions).",
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/PropItem",
          "description": "A new item's values."
        },
        "visible": {
          "description": "The key of each item's on/off visibility, shown as a Switch named \"Show\".",
          "type": "string"
        }
      },
      "required": [
        "key",
        "add",
        "item",
        "remove",
        "rows",
        "template"
      ],
      "type": "object"
    },
    "InspectorOption": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "InspectorSection": {
      "additionalProperties": false,
      "description": "One group of the inspector, a PropertySection.",
      "properties": {
        "action": {
          "additionalProperties": false,
          "description": "An action under the rows (Export): its label, and what the example says when pressed.",
          "properties": {
            "label": {
