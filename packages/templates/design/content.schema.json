{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/design/content/1",
  "title": "Design tool content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/design/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "DesignAppSpec": {
      "additionalProperties": false,
      "properties": {
        "comments": {
          "$ref": "#/$defs/DesignCommentsSpec",
          "description": "Comment mode: threads pinned to layers, in the properties panel (Q66, F15.T6)."
        },
        "defaults": {
          "additionalProperties": false,
          "description": "Every layer's starting values, by kind (`all` first, then the kind's own); a layer's `props` override them.",
          "properties": {
            "all": {
              "$ref": "#/$defs/ShapeProps"
            },
            "ellipse": {
              "$ref": "#/$defs/ShapeProps"
            },
            "frame": {
              "$ref": "#/$defs/ShapeProps"
            },
            "page": {
              "$ref": "#/$defs/ShapeProps"
            },
            "rectangle": {
              "$ref": "#/$defs/ShapeProps"
            },
            "text": {
              "$ref": "#/$defs/ShapeProps"
            }
          },
          "required": [
            "all",
            "ellipse",
            "frame",
            "rectangle",
            "text"
          ],
          "type": "object"
        },
        "file": {
          "type": "string"
        },
        "fills": {
          "description": "Fill names for the category colours 1–8, as the fill field offers them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "height": {
          "type": "number"
        },
        "inspector": {
          "description": "The inspector's tabs (Design, Prototype, Dev), their sections and controls (Q66.3).",
          "items": {
            "$ref": "#/$defs/InspectorTab"
          },
          "type": "array"
        },
        "menu": {
          "description": "The main menu at the top of the layers panel: its commands (none run in the example).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "modes": {
          "description": "The mode switch at the end of the tool bar: Draw, Design, Dev Mode (only Design is built).",
          "items": {
            "$ref": "#/$defs/DesignTool"
          },
          "type": "array"
        },
        "page": {
          "type": "string"
        },
        "pageColour": {
          "additionalProperties": false,
          "description": "The page colour by scheme until the person sets one (the canvas grey).",
          "properties": {
            "dark": {
              "type": "string"
            },
            "light": {
              "type": "string"
            }
          },
          "required": [
            "light",
            "dark"
          ],
          "type": "object"
        },
        "pages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "people": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "presence": {
                "enum": [
                  "available",
                  "away"
                ],
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "present": {
          "$ref": "#/$defs/DesignPresentSpec",
          "description": "Present mode: the prototype played full size, frame by frame (Q66, F15.T6)."
        },
        "project": {
          "type": "string"
        },
        "selected": {
          "description": "Selected when the editor opens.",
          "type": "string"
        },
        "shapes": {
          "items": {
            "$ref": "#/$defs/DesignShape"
          },
          "type": "array"
        },
        "strings": {
          "$ref": "#/$defs/DesignStrings",
          "description": "Every interface word the screens show."
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/DesignTool"
          },
          "type": "array"
        },
        "width": {
          "description": "The page's size in document units, so the canvas scrolls to every frame.",
          "type": "number"
        },
        "zooms": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "file",
        "project",
        "menu",
        "pages",
        "page",
        "pageColour",
        "people",
        "tools",
        "modes",
        "zooms",
        "width",
        "height",
        "shapes",
        "defaults",
        "inspector",
        "fills",
        "present",
        "comments",
        "strings"
      ],
      "type": "object"
    },
    "DesignComment": {
      "additionalProperties": false,
      "description": "One comment: who, when and what.",
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "DesignCommentsSpec": {
      "additionalProperties": false,
      "description": "Comment mode's threads and words.",
      "properties": {
        "me": {
          "description": "Who is writing replies in the example.",
          "type": "string"
        },
        "strings": {
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string"
            },
            "none": {
              "description": "No open threads on the page.",
              "type": "string"
            },
            "now": {
              "description": "A new reply's time: \"Just now\".",
              "type": "string"
            },
            "onLayer": {
              "description": "\"On {layer}\".",
              "type": "string"
            },
            "reopen": {
              "type": "string"
            },
            "reply": {
              "type": "string"
            },
            "replyLabel": {
              "type": "string"
            },
            "resolve": {
              "type": "string"
            },
            "resolved": {
              "description": "Said when a thread is resolved: \"Resolved: {layer}\".",
              "type": "string"
            },
            "showResolved": {
              "type": "string"
            }
          },
          "required": [
            "heading",
            "showResolved",
            "onLayer",
            "reply",
            "replyLabel",
            "now",
            "resolve",
            "reopen",
            "resolved",
            "none"
          ],
          "type": "object"
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/DesignThread"
          },
          "type": "array"
        }
      },
      "required": [
        "me",
        "threads",
        "strings"
      ],
      "type": "object"
    },
    "DesignPresentSpec": {
      "additionalProperties": false,
      "description": "Present mode's frames and words. `{name}` marks a value filled in.",
      "properties": {
        "frames": {
          "description": "The frames in the order Previous and Next move through them; the first is the flow's starting point.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "strings": {
          "additionalProperties": false,
          "properties": {
            "back": {
              "type": "string"
            },
            "frames": {
              "description": "The panel of frames.",
              "type": "string"
            },
            "goesTo": {
              "description": "A hotspot's description in the list: \"Goes to {frame}\".",
              "type": "string"
            },
            "hotspots": {
              "description": "The panel listing what can be pressed in this frame.",
              "type": "string"
            },
            "next": {
              "type": "string"
            },
            "noHotspots": {
              "type": "string"
            },
            "nothingHere": {
              "description": "Said when a part with no interaction is pressed.",
              "type": "string"
            },
            "position": {
              "description": "\"{frame}, {n} of {count}\".",
              "type": "string"
            },
            "previous": {
              "type": "string"
            },
            "restart": {
              "type": "string"
            },
            "stage": {
              "description": "The stage's name: \"{frame}, presented\".",
              "type": "string"
            }
          },
          "required": [
            "frames",
            "hotspots",
            "back",
            "previous",
            "next",
            "restart",
            "position",
            "stage",
            "goesTo",
            "noHotspots",
            "nothingHere"
          ],
          "type": "object"
        }
      },
      "required": [
        "frames",
        "strings"
      ],
      "type": "object"
    },
    "DesignShape": {
      "additionalProperties": false,
      "description": "A layer in the document: what the canvas draws, plus its inspector values.",
      "properties": {
        "category": {
          "description": "A rectangle's or ellipse's fill: one of the eight category colours (1–8). None: the raised surface.",
          "type": "number"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/DesignShape"
          },
          "type": "array"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "frame",
            "rectangle",
            "ellipse",
            "text"
          ],
          "type": "string"
        },
        "label": {
          "description": "Its name, as in the layers: \"Header\", \"Sign in button\". Names it for assistive technology.",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/ShapeProps"
        },
        "text": {
          "description": "The words of a text shape.",
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "description": "Position and size in the document's own units (CSS pixels at 100 %), relative to its frame or the canvas.",
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "height",
        "id",
        "kind",
        "label",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "DesignStrings": {
      "additionalProperties": false,
      "description": "Interface words (Q64: every word a person reads is content). `{name}` marks a value filled in.",
      "properties": {
        "addPage": {
          "description": "The Pages heading's add button: \"Add page\".",
          "type": "string"
        },
        "assetsTab": {
          "type": "string"
        },
        "canvas": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "fileTab": {
          "description": "The left panel's tabs: \"File\" and \"Assets\".",
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "inspector": {
          "type": "string"
        },
        "kindEllipse": {
          "type": "string"
        },
        "kindFrame": {
          "type": "string"
        },
        "kindRectangle": {
          "type": "string"
        },
        "kindText": {
          "type": "string"
        },
        "layers": {
          "type": "string"
        },
        "lockLayer": {
          "description": "A layer row's lock Switch: \"Lock {name}\".",
          "type": "string"
        },
        "lockVerb": {
          "type": "string"
        },
        "mainMenu": {
          "description": "The main menu's icon button: \"Main menu\".",
          "type": "string"
        },
        "mode": {
          "description": "Names the mode switch: \"Mode\".",
          "type": "string"
        },
        "moreTools": {
          "description": "A tool's flyout button: \"More {tool} tools\".",
          "type": "string"
        },
        "noAssets": {
          "description": "The Assets tab, empty in the example.",
          "type": "string"
        },
        "noColours": {
          "type": "string"
        },
        "notInExample": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "present": {
          "description": "The play button beside Share: \"Present\".",
          "type": "string"
        },
        "propertyLabels": {
          "description": "The Switch that shows every field's label above it: \"Property labels\".",
          "type": "string"
        },
        "searchLayers": {
          "description": "The search button at the end of the File and Assets tabs.",
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "sharing": {
          "type": "string"
        },
        "showLayer": {
          "description": "A layer row's visibility Switch; {name} is the layer: \"Show {name}\".",
          "type": "string"
        },
        "showVerb": {
          "description": "The verbs of a layer row's eye and padlock: \"Show\", \"Lock\".",
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "viewOptions": {
          "description": "The properties panel's view options (a Popover): \"View options\".",
          "type": "string"
        },
        "width": {
          "type": "string"
        },
        "working": {
          "type": "string"
        },
        "xPosition": {
          "type": "string"
        },
        "yPosition": {
          "type": "string"
        },
        "zoom": {
          "type": "string"
        },
        "zoomTo": {
          "type": "string"
        },
        "zoomValue": {
          "type": "string"
        }
      },
      "required": [
        "kindFrame",
        "kindRectangle",
        "kindEllipse",
        "kindText",
        "tool",
        "zoom",
        "zoomValue",
        "zoomTo",
        "working",
        "share",
        "viewOptions",
        "propertyLabels",
        "showLayer",
        "lockLayer",
        "notInExample",
        "sharing",
        "pages",
        "layers",
        "position",
        "xPosition",
        "yPosition",
        "size",
        "width",
        "height",
        "fill",
        "surface",
        "text",
        "empty",
        "inspector",
        "noColours",
        "canvas",
        "mainMenu",
        "fileTab",
        "assetsTab",
        "noAssets",
        "present",
        "mode",
        "searchLayers",
        "moreTools",
        "addPage",
        "showVerb",
        "lockVerb"
      ],
      "type": "object"
    },
    "DesignThread": {
      "additionalProperties": false,
      "description": "A comment thread pinned to a layer.",
      "properties": {
        "author": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "description": "The layer it's pinned to.",
          "type": "string"
        },
        "replies": {
          "items": {
            "$ref": "#/$defs/DesignComment"
          },
          "type": "array"
        },
        "resolved": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "id",
        "layer",
        "replies",
        "text",
        "time"
      ],
      "type": "object"
    },
    "DesignTool": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "label": {
          "type": "string"
        },
        "menu": {
          "description": "The tool's flyout: the tools that share its place in the bar (the first is the tool itself).",
          "items": {
            "$ref": "#/$defs/DesignTool"
          },
          "type": "array"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "icon"
      ],
      "type": "object"
    },
