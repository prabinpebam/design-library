          {
            "label": "Files",
            "href": "/files"
          },
          {
            "label": "Drafts",
            "href": "/drafts"
          },
          {
            "label": "Search",
            "href": "/file-search"
          },
          {
            "label": "Editor",
            "href": "/editor"
          }
