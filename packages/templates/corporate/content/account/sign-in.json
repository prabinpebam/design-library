        "submit": "Sign in",
        "sent": "Signed in. Your shipments would open next; this example stops here.",
        "links": [
          {
            "label": "Forgot your password?",
            "href": "/forgot-password"
          },
          {
            "label": "Create an account",
            "href": "/sign-up"
          }
