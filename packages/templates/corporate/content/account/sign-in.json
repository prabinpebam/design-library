{
  "$schema": "../../content.schema.json",
  "template": "corporate",
  "layout": "sign-in",
  "contentVersion": 1,
  "settings": {
    "current": "sign-in",
    "width": "reading"
  },
  "regions": {
    "main": [
      {
        "type": "form",
        "choose": "Choose one",
        "enter": "Enter {field}.",
        "pick": "Choose {field}.",
