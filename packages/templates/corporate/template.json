{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "corporate",
  "version": "1.0.0",
  "title": "Corporate site",
  "summary": "A company’s site: what it does, who it is, jobs and a way to get in touch.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "shared": "content/shared.json",
  "assets": "assets.json",
  "home": "home",
  "sections": [
    {
      "id": "site",
      "title": "Company",
      "summary": "What the company does and for whom.",
      "flows": [
        {
          "id": "explore",
          "title": "Get to know the company",
          "summary": "Find out who they are and what they stand for.",
          "screens": [
            "home",
            "about"
          ]
        },
        {
          "id": "services",
          "title": "Compare services",
          "summary": "See what they offer and what one service includes.",
          "screens": [
            "services",
            "service"
          ]
        },
        {
          "id": "customers",
          "title": "Read a customer story",
          "summary": "See proof from a customer like you.",
          "screens": [
            "customers",
            "story"
          ]
        }
      ]
    },
    {
      "id": "careers",
      "title": "Careers and contact",
      "summary": "Join the company, or get in touch and visit.",
      "flows": [
        {
          "id": "jobs",
          "title": "Find a job",
          "summary": "Browse openings and read one in full.",
          "screens": [
            "careers",
            "job"
          ]
        },
        {
          "id": "apply",
          "title": "Apply for a job",
          "summary": "Send an application and know what happens next.",
          "screens": [
            "apply"
          ]
        },
        {
          "id": "message",
          "title": "Send a message",
          "summary": "Ask a question and get an answer by email.",
          "screens": [
            "contact"
          ]
        },
        {
          "id": "visit",
          "title": "Visit an office",
          "summary": "Find an office and how to get there.",
          "screens": [
            "offices"
          ]
        }
      ]
    },
    {
      "id": "account",
      "title": "Client account",
      "summary": "Signing in, creating an account and keeping it.",
      "flows": [
        {
          "id": "sign-in",
          "title": "Sign in",
          "summary": "Get into the account, or back in after forgetting the password.",
          "screens": [
            "sign-in",
            "forgot-password"
          ]
        },
        {
          "id": "sign-up",
          "title": "Create an account",
          "summary": "Open an account and confirm the email address.",
          "screens": [
            "sign-up"
          ]
        },
        {
          "id": "settings",
          "title": "Manage the account",
          "summary": "Change details and what the company sends.",
          "screens": [
            "account-settings",
            "notification-settings"
          ]
        }
      ]
    },
    {
      "id": "help",
      "title": "News and help",
      "summary": "The latest news, search, and help when something goes wrong.",
      "flows": [
        {
          "id": "news",
          "title": "Follow the news",
          "summary": "Read what changed lately.",
          "screens": [
            "news",
            "news-article"
          ]
        },
        {
          "id": "search",
          "title": "Search the site",
          "summary": "Find a page by what it says.",
          "screens": [
            "search"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and the way back.",
          "screens": [
            "not-found",
            "server-error",
            "maintenance"
          ]
        },
        {
          "id": "legal",
          "title": "Read the policies",
          "summary": "Know how personal data is used.",
          "screens": [
            "privacy"
          ]
        }
      ]
    }
  ],
