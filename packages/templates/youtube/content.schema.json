{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/youtube/content/1",
  "title": "Video site content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/youtube/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/YoutubeRecord"
    },
    "YoutubeGuideEntry": {
      "additionalProperties": false,
      "description": "One guide destination: a core icon and its label.",
      "properties": {
        "current": {
          "description": "The page being shown.",
          "type": "boolean"
        },
        "icon": {
          "description": "A core icon name.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "mini": {
          "description": "Also shown in the mini guide (the 72 wide column of icons over short labels).",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "icon"
      ],
      "type": "object"
    },
    "YoutubeGuideSection": {
      "additionalProperties": false,
      "description": "A guide section: an optional heading over its destinations, or a short signed-out prompt with a sign-in action.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/YoutubeGuideEntry"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "prompt": {
          "description": "A signed-out prompt shown instead of destinations.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "YoutubeRecord": {
      "additionalProperties": false,
      "properties": {
        "chips": {
          "description": "Feed filters; the first is selected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "guide": {
          "items": {
            "$ref": "#/$defs/YoutubeGuideSection"
          },
          "type": "array"
        },
        "videos": {
          "items": {
            "$ref": "#/$defs/YoutubeVideo"
          },
          "type": "array"
        },
        "wordmark": {
          "description": "The neutral wordmark beside the guide button: never a product logo.",
          "type": "string"
        }
      },
      "required": [
        "wordmark",
        "guide",
        "chips",
        "videos",
        "copy"
      ],
      "type": "object"
    },
    "YoutubeVideo": {
      "additionalProperties": false,
      "description": "One video in the feed. Pictures are neutral frames; every title and channel is original.",
      "properties": {
        "age": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "duration": {
          "description": "Length shown on the frame (\"12:04\").",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "views": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "channel",
        "views",
        "age",
        "duration"
      ],
      "type": "object"
    }
  }
}
