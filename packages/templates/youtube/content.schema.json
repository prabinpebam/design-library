{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/youtube/content/1",
  "title": "Video site content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/youtube/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/YoutubeRecord"
    },
    "YoutubeComment": {
      "additionalProperties": false,
      "description": "One comment under the video being watched.",
      "properties": {
        "age": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "likes": {
          "description": "Like count as shown (\"1.2K\").",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "age",
        "text",
        "likes"
      ],
      "type": "object"
    },
    "YoutubeGuideEntry": {
      "additionalProperties": false,
      "description": "One guide destination: a core icon and its label.",
      "properties": {
        "current": {
          "description": "The page being shown.",
          "type": "boolean"
        },
        "icon": {
          "description": "A core icon name.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "mini": {
          "description": "Also shown in the mini guide (the 72 wide column of icons over short labels).",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "icon"
      ],
      "type": "object"
    },
    "YoutubeGuideSection": {
      "additionalProperties": false,
      "description": "A guide section: an optional heading over its destinations, or a short signed-out prompt with a sign-in action.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/YoutubeGuideEntry"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "prompt": {
          "description": "A signed-out prompt shown instead of destinations.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "YoutubeRecord": {
      "additionalProperties": false,
      "properties": {
        "chips": {
          "description": "Feed filters; the first is selected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "guide": {
          "items": {
            "$ref": "#/$defs/YoutubeGuideSection"
          },
          "type": "array"
        },
        "search": {
          "$ref": "#/$defs/YoutubeSearch",
          "description": "The search results page."
        },
        "videos": {
          "items": {
            "$ref": "#/$defs/YoutubeVideo"
          },
          "type": "array"
        },
        "watch": {
          "$ref": "#/$defs/YoutubeWatch",
          "description": "The watch page: the video being watched; up next is every other video."
        },
        "wordmark": {
          "description": "The neutral wordmark beside the guide button: never a product logo.",
          "type": "string"
        }
      },
      "required": [
        "wordmark",
        "guide",
        "chips",
        "videos",
        "watch",
        "search",
        "copy"
      ],
      "type": "object"
    },
    "YoutubeSearch": {
      "additionalProperties": false,
      "description": "The search results page: the query in the masthead, its filters and the results.",
      "properties": {
        "chips": {
          "description": "Result filters; the first is selected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "query": {
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/YoutubeSearchResult"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "chips",
        "results"
      ],
      "type": "object"
    },
    "YoutubeSearchResult": {
      "additionalProperties": false,
      "description": "One search result: a video from `videos` and the matching words under it.",
      "properties": {
        "badges": {
          "description": "Format marks under the snippet, such as \"4K\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "chapters": {
          "additionalProperties": false,
          "description": "The chapters strip on a row whose video has chapters: \"N chapters\" and the chapter titles, one line.",
          "properties": {
            "count": {
              "type": "string"
            },
            "titles": {
              "type": "string"
            }
          },
          "required": [
            "count",
            "titles"
          ],
          "type": "object"
        },
        "snippet": {
          "description": "The description's matching words, up to two lines.",
          "type": "string"
        },
        "video": {
          "description": "The `id` of the video in `videos`.",
          "type": "string"
        }
      },
      "required": [
        "video",
        "snippet"
      ],
      "type": "object"
    },
    "YoutubeVideo": {
      "additionalProperties": false,
      "description": "One video in the feed. Pictures are neutral frames; every title and channel is original.",
      "properties": {
        "age": {
          "type": "string"
        },
        "aspect": {
          "description": "The video's own shape; the watch page's player is as tall as it makes it. Default `16:9`.",
          "enum": [
            "16:9",
            "4:3"
          ],
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "duration": {
          "description": "Length shown on the frame (\"12:04\").",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "thumbnail": {
          "description": "The asset id of its thumbnail in `assets.json`: drawn on every card, result and up-next item, and in the player.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "views": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "channel",
        "views",
        "age",
        "duration"
      ],
      "type": "object"
    },
    "YoutubeWatch": {
      "additionalProperties": false,
      "description": "The video being watched: one of `videos`, with what the watch page adds around it.",
      "properties": {
        "commentCount": {
          "description": "\"N Comments\".",
          "type": "string"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/YoutubeComment"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "likes": {
          "description": "Like count as shown on the like button (\"12K\").",
          "type": "string"
        },
        "stats": {
          "description": "The description's first line: views and date (\"412,309 views  3 days ago\").",
          "type": "string"
        },
        "subscribers": {
          "type": "string"
        },
        "video": {
          "description": "The `id` of the video in `videos`.",
          "type": "string"
        }
      },
      "required": [
        "video",
        "subscribers",
        "likes",
        "stats",
        "description",
        "commentCount",
        "comments"
      ],
      "type": "object"
    }
  }
}
