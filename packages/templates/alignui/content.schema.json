{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/alignui/content/1",
  "title": "Component library in AlignUI's look content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/alignui/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "AlignuiCategory": {
      "additionalProperties": false,
      "description": "A category of components (Actions, Form…): its in-page anchor, title, one line and its previews.",
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/$defs/AlignuiExample"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "examples"
      ],
      "type": "object"
    },
    "AlignuiDemo": {
      "description": "One demo the showcase knows how to draw; each is built from core components only.",
      "enum": [
        "button",
        "button-sizes",
        "compact-button",
        "link-button",
        "button-group",
        "dropdown",
        "input",
        "input-states",
        "textarea",
        "select",
        "checkbox",
        "radio",
        "switch",
        "slider",
        "datepicker",
        "avatar",
        "badge",
        "status-badge",
        "tag",
        "kbd",
        "progress-bar",
        "rating",
        "tooltip",
        "segmented-control",
        "alert",
        "toast",
        "accordion",
        "breadcrumb",
        "tab-horizontal",
        "tab-vertical",
        "pagination",
        "modal",
        "drawer",
        "popover",
        "table",
        "file-upload"
      ],
      "type": "string"
    },
    "AlignuiExample": {
      "additionalProperties": false,
      "description": "One component's preview: what it is and the demo that shows its variants and states.",
      "properties": {
        "demo": {
          "$ref": "#/$defs/AlignuiDemo"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "demo",
        "title",
        "description"
      ],
      "type": "object"
    },
    "AlignuiGroup": {
      "additionalProperties": false,
      "description": "A kind of component (fundamentals or compounds) and its categories.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/AlignuiCategory"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "categories"
      ],
      "type": "object"
    },
    "AlignuiRecord": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/AlignuiGroup"
          },
          "type": "array"
        },
        "home": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "page": {
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "string"
            },
            "navLabel": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "lead",
            "navLabel"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ],
          "type": "object"
        },
        "words": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The words inside the demos, by key.",
          "type": "object"
        }
      },
      "required": [
        "name",
        "home",
        "source",
        "page",
        "groups",
        "words"
      ],
      "type": "object"
    },
    "record.shared": {
      "$ref": "#/$defs/AlignuiRecord"
    }
  }
}
