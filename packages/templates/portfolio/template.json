  "sections": [
    {
      "id": "work",
      "title": "Work",
      "summary": "The projects, how they were made, and a way back from a missing page.",
      "flows": [
        {
          "id": "browse",
          "title": "Browse the work",
          "summary": "See the projects at a glance and pick one.",
          "screens": [
            "home",
            "work"
          ]
        },
        {
          "id": "case",
          "title": "Read a case study",
          "summary": "Follow one project from brief to result.",
          "screens": [
            "project",
            "process"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and the way back.",
          "screens": [
            "not-found"
          ]
        }
      ]
    },
    {
      "id": "about",
      "title": "About",
      "summary": "Who the designer is.",
      "flows": [
        {
          "id": "story",
          "title": "Meet the designer",
          "summary": "Background, experience and the full résumé.",
          "screens": [
            "about",
            "resume"
          ]
        },
        {
          "id": "talks",
          "title": "Watch talks",
          "summary": "Talks given, with recordings.",
          "screens": [
            "speaking"
          ]
        },
        {
          "id": "writing",
          "title": "Read the writing",
          "summary": "Essays and notes.",
          "screens": [
            "writing"
          ]
        },
        {
          "id": "uses",
          "title": "See the tools",
          "summary": "What the work is made with.",
          "screens": [
            "uses"
          ]
        }
      ]
    },
    {
      "id": "hire",
      "title": "Hire",
      "summary": "Getting in touch about work.",
      "flows": [
        {
          "id": "contact",
          "title": "Get in touch",
          "summary": "Send a message about a project.",
          "screens": [
            "contact"
          ]
        },
        {
          "id": "booking",
          "title": "Book a call",
          "summary": "Pick a time for an introduction call.",
          "screens": [
            "booking"
          ]
        },
        {
          "id": "availability",
          "title": "Check availability",
          "summary": "Know when the designer is free and the rates.",
          "screens": [
            "availability"
          ]
        },
        {
          "id": "quote",
          "title": "Ask for a quote",
          "summary": "Describe a project and get a price and a start date.",
          "screens": [
            "quote-request"
          ]
        }
      ]
    }
