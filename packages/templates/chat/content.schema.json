{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/chat/content/1",
  "title": "AI chat content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/chat/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "ChatAppView": {
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "description": "Who replies, said before each reply (\"Assistant said\").",
          "type": "string"
        },
        "current": {
          "description": "The chat open at the start.",
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/MenuButtonItem"
          },
          "type": "array"
        },
        "replies": {
          "additionalProperties": false,
          "description": "What the assistant writes to a new message, and with the Create image tool.",
          "properties": {
            "image": {
              "items": {
                "$ref": "#/$defs/ChatBlock"
              },
              "type": "array"
            },
            "text": {
              "items": {
                "$ref": "#/$defs/ChatBlock"
              },
              "type": "array"
            },
            "thinking": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "thinking",
            "text",
            "image"
          ],
          "type": "object"
        },
        "shareBase": {
          "description": "The link Share offers.",
          "type": "string"
        },
        "sidebar": {
          "additionalProperties": false,
          "properties": {
            "account": {
              "additionalProperties": false,
              "properties": {
                "menu": {
                  "items": {
                    "$ref": "#/$defs/MenuButtonItem"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "plan": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "plan",
                "menu"
              ],
              "type": "object"
            },
            "groups": {
              "items": {
                "$ref": "#/$defs/ConversationGroup"
              },
              "type": "array"
            }
          },
          "required": [
            "groups",
            "account"
          ],
          "type": "object"
        },
        "strings": {
          "$ref": "#/$defs/ChatStrings",
          "description": "Every interface word the chat shows."
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/ChatThread"
          },
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ComposerTool"
          },
          "type": "array"
        },
        "welcome": {
          "additionalProperties": false,
          "properties": {
            "greeting": {
              "type": "string"
            },
            "suggestions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "temporary": {
              "additionalProperties": false,
              "properties": {
                "greeting": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "greeting",
                "note"
              ],
              "type": "object"
            }
          },
          "required": [
            "greeting",
            "suggestions",
            "temporary"
          ],
          "type": "object"
        }
      },
      "required": [
        "assistant",
        "sidebar",
        "models",
        "model",
        "tools",
        "disclaimer",
        "welcome",
        "threads",
        "current",
        "replies",
        "shareBase",
        "strings"
      ],
      "type": "object"
    },
    "ChatAttachment": {
      "additionalProperties": false,
      "description": "One thing sent with a message: a picture (shown as a thumbnail) or a file (a tile with its name and type).",
      "properties": {
        "alt": {
          "description": "Images: what the picture shows, for people who can't see it. Defaults to the name.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "file"
          ],
          "type": "string"
        },
        "name": {
          "description": "The file's name, as the person saved it: \"review-notes.pdf\".",
          "type": "string"
        },
        "src": {
          "description": "Images: the picture's address.",
          "type": "string"
        },
        "type": {
          "description": "Files: the type in words, \"PDF\", \"Spreadsheet\", shown under the name.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    },
    "ChatBlock": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "heading",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "numbered": {
              "type": "boolean"
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "code",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "header": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "header"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "label": {
              "type": "string"
            },
            "rows": {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            "type": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "columns",
            "rows"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "picture": {
              "type": "string"
            },
            "ratio": {
              "enum": [
                "wide",
                "photo",
                "square"
              ],
              "type": "string"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "picture"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "picture": {
              "type": "string"
            },
            "ratio": {
              "enum": [
                "photo",
                "square",
                "wide"
              ],
              "type": "string"
            },
            "seconds": {
              "type": "number"
            },
            "type": {
              "const": "generating",
              "type": "string"
            },
            "variant": {
              "enum": [
                "stipple",
                "aurora",
                "reveal",
                "shimmer"
              ],
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "picture"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "picture": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "const": "card",
              "type": "string"
            }
          },
          "required": [
            "type",
            "title",
            "description"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "href": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "type": {
              "const": "sources",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "retry": {
              "items": {
                "$ref": "#/$defs/ChatBlock"
              },
              "type": "array"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text",
            "retry"
          ],
          "type": "object"
        }
      ],
      "description": "One block of a message, in order. Words may hold `inline code` between backticks."
    },
    "ChatStrings": {
      "additionalProperties": false,
      "description": "The chat's interface words (Q64: every word a person reads is content). `{name}` marks a value filled in.",
      "properties": {
        "account": {
          "type": "string"
        },
        "archived": {
          "type": "string"
        },
        "branchTitle": {
          "type": "string"
        },
        "branched": {
          "type": "string"
        },
        "cancel": {
          "type": "string"
        },
        "chats": {
          "type": "string"
        },
        "copyLink": {
          "type": "string"
        },
        "creatingImage": {
          "type": "string"
        },
        "delete": {
          "type": "string"
        },
        "deleteDescription": {
          "type": "string"
        },
        "deleteTitle": {
          "type": "string"
        },
        "deleted": {
          "type": "string"
        },
        "dictation": {
          "type": "string"
        },
        "done": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "linkCopied": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "memoryDescription": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "newChat": {
          "type": "string"
        },
        "noMatch": {
          "type": "string"
        },
        "notInExample": {
          "type": "string"
        },
        "replyFailed": {
          "type": "string"
        },
        "search": {
          "type": "string"
        },
        "searchChats": {
          "type": "string"
        },
        "settings": {
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "shareDescription": {
          "type": "string"
        },
        "shareTitle": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        },
        "stopped": {
          "type": "string"
        },
        "suggestions": {
          "type": "string"
        },
        "suggestionsDescription": {
          "type": "string"
        },
        "temporaryChat": {
          "type": "string"
        },
        "thoughtFor": {
          "type": "string"
        },
        "todayGroup": {
          "type": "string"
        },
        "tryAgain": {
          "type": "string"
        },
        "undo": {
          "type": "string"
        },
        "you": {
          "type": "string"
        }
      },
      "required": [
        "notInExample",
        "sources",
        "replyFailed",
        "tryAgain",
        "thoughtFor",
        "todayGroup",
        "branchTitle",
        "branched",
        "archived",
        "undo",
        "you",
        "stopped",
        "creatingImage",
        "dictation",
        "newChat",
        "searchChats",
        "account",
        "model",
        "temporaryChat",
        "share",
        "shareTitle",
        "shareDescription",
        "done",
        "link",
        "copyLink",
        "linkCopied",
        "search",
        "chats",
        "noMatch",
        "deleteTitle",
        "deleteDescription",
        "cancel",
        "delete",
        "deleted",
        "settings",
        "suggestions",
        "suggestionsDescription",
        "memory",
        "memoryDescription"
      ],
      "type": "object"
    },
    "ChatThread": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/ChatTurn"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "turns"
      ],
      "type": "object"
    },
    "ChatTurn": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/ChatAttachment"
          },
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/ChatBlock"
          },
          "type": "array"
        },
        "earlier": {
          "description": "Earlier versions of a reply (after Try again), oldest first; `blocks` is the newest.",
          "items": {
            "items": {
              "$ref": "#/$defs/ChatBlock"
            },
            "type": "array"
          },
          "type": "array"
        },
        "from": {
          "enum": [
            "person",
            "assistant"
          ],
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "thinking": {
          "additionalProperties": false,
          "description": "What the assistant thought or did before replying, closed under its summary.",
          "properties": {
            "steps": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "summary",
            "steps"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "from",
        "blocks"
      ],
      "type": "object"
    },
    "ComposerTool": {
      "additionalProperties": false,
      "description": "A tool the next message can use (Create image, Deep research, Web search).",
      "properties": {
        "description": {
          "description": "One short line in the menu: what the tool does.",
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/IconName",
          "description": "Shown on the chosen tool's chip."
        },
        "label": {
          "description": "A verb or a noun phrase, sentence case: \"Create image\".",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "Conversation": {
      "additionalProperties": false,
      "description": "One conversation in the list.",
      "properties": {
        "href": {
          "description": "Where it opens, so it can open in a new tab and be copied; leave out to open through `onOpen` only.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "description": "Its title, usually written from the first message: \"Weekend walk in the Lake District\".",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "ConversationGroup": {
      "additionalProperties": false,
      "description": "Conversations under one heading, newest first: \"Today\", \"Yesterday\", \"Previous 7 days\", a project's name.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "items"
      ],
      "type": "object"
    },
    "FlagCode": {
      "enum": [
        "in",
        "us",
        "gb",
        "de",
        "jp",
        "fr",
        "br",
        "au",
        "ca",
        "cn"
      ],
      "type": "string"
    },
    "IconName": {
      "enum": [
        "check",
        "close",
        "chevron-start",
        "chevron-end",
        "chevron-down",
        "external",
        "info",
        "success",
        "warning",
        "error",
        "plus",
        "minus",
        "search",
        "menu",
        "scheme-light",
        "scheme-dark",
        "contrast-standard",
        "contrast-more",
        "settings",
        "comment",
        "thumb-up",
        "thumb-down",
        "retry",
        "speaker",
        "branch",
        "copy",
        "person",
        "people",
        "organisation",
        "bot",
        "pause",
        "play",
        "more",
        "trend-up",
        "trend-down",
        "trend-flat",
        "image",
        "edit",
        "file",
        "pointer",
        "hand",
        "frame",
        "rectangle",
        "ellipse",
        "text",
        "layers",
        "properties",
        "board",
        "list",
        "grid",
        "upload",
        "mic",
        "arrow-up",
        "stop",
        "globe",
        "align-left",
        "align-h-center",
        "align-right",
        "align-top",
        "align-v-center",
        "align-bottom",
        "distribute-h",
        "distribute-v",
        "text-start",
        "text-center",
        "text-end",
        "text-justify",
        "eye",
        "eye-off",
        "arrow-down",
        "arrow-end",
        "wrap",
        "corners",
        "sides",
        "link",
        "rotate",
        "code",
        "component",
        "constraint-h",
        "constraint-v",
        "size-width",
        "size-height",
        "stroke-position",
        "blend"
      ],
      "type": "string"
    },
    "MenuButtonItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "One short line under the name: what choosing it does or gives.",
          "type": "string"
        },
        "flag": {
          "$ref": "#/$defs/FlagCode",
          "description": "A country's flag before the name. Decorative."
        },
        "label": {
          "description": "The item's name, in sentence case.",
          "type": "string"
        },
        "preview": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "value": {
          "description": "What `onSelect` receives.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "record.chat": {
      "$ref": "#/$defs/ChatAppView"
    }
  }
}
