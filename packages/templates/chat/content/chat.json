      {
        "id": "ring",
        "title": "Change the focus ring colour",
        "turns": [
          {
            "id": "r1",
            "from": "person",
            "blocks": [
              {
                "type": "text",
                "text": "How do I change the focus ring colour for text fields only?"
              }
            ]
          },
          {
            "id": "r2",
            "from": "assistant",
            "earlier": [
              [
                {
                  "type": "text",
                  "text": "Set `c.field.ring-color` in the token source and rebuild the tokens."
                }
              ]
            ],
            "blocks": [
              {
                "type": "text",
                "text": "Change `c.field.ring-color` in the token source, then run `npm run tokens`. Every text-entry box reads it; buttons keep the page’s focus colour."
              },
              {
                "type": "code",
                "label": "tokens.json",
                "code": "{\n  \"c\": {\n    \"field\": {\n      \"ring-color\": { \"$type\": \"color\", \"$value\": \"{color.accent}\" }\n    }\n  }\n}"
              }
            ]
          }
        ]
      },
