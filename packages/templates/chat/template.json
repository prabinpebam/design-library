{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "chat",
  "version": "1.0.0",
  "title": "AI chat",
  "summary": "A ChatGPT-like assistant: chat history, the model menu, rich replies, generated pictures and the composer.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "assets": "assets.json",
  "home": "chat",
  "sections": [
    {
      "id": "converse",
      "title": "Converse",
      "summary": "Talk with the assistant, share a chat, and what happens when a reply can’t come.",
      "flows": [
        {
          "id": "chat",
          "title": "Chat",
          "summary": "Ask, read the answer and keep going.",
          "screens": [
            "chat"
          ]
        },
        {
          "id": "share",
          "title": "Share a chat",
          "summary": "Make a link to a chat and read a shared one.",
          "screens": [
            "share-chat",
            "shared-chat"
          ]
        },
        {
          "id": "voice",
          "title": "Talk by voice",
          "summary": "Speak and listen instead of typing.",
          "screens": [
            "voice"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and when it will work again.",
          "screens": [
            "offline",
            "rate-limited",
            "not-found"
          ]
        }
      ]
    },
    {
      "id": "find",
      "title": "Find",
      "summary": "Getting back to earlier work.",
      "flows": [
        {
          "id": "search",
          "title": "Search chats",
          "summary": "Find a chat by what was said.",
          "screens": [
            "search-chats"
          ]
        },
        {
          "id": "library",
          "title": "Browse images",
          "summary": "Every picture made in a chat.",
          "screens": [
            "images"
          ]
        },
        {
          "id": "projects",
          "title": "Organise by project",
          "summary": "Keep related chats and files together.",
          "screens": [
            "chat-projects",
            "chat-project"
          ]
        }
      ]
    },
    {
      "id": "account",
      "title": "Account",
      "summary": "Signing in and the first run.",
      "flows": [
        {
          "id": "sign-in",
          "title": "Sign in",
          "summary": "Sign in or create an account.",
          "screens": [
            "sign-in",
            "sign-up"
          ]
        },
        {
          "id": "onboarding",
          "title": "Get started",
          "summary": "Say what the assistant should know and how it should reply.",
          "screens": [
            "welcome",
            "choose-style"
          ]
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "summary": "Changing how it works and the plan.",
      "flows": [
        {
          "id": "general",
          "title": "Change settings",
          "summary": "Appearance, personalisation and what happens to data.",
          "screens": [
            "settings-general",
            "settings-personalisation",
            "settings-data"
          ]
        },
        {
          "id": "plan",
          "title": "Upgrade the plan",
          "summary": "Compare plans, pay and start using it.",
          "screens": [
            "plans",
            "checkout"
          ]
        },
        {
          "id": "export",
          "title": "Export your data",
          "summary": "Get a copy of every chat and file to keep or move elsewhere.",
          "screens": [
            "export-data"
          ]
        }
      ]
    }
  ],
  "layouts": [
    {
      "id": "chat",
      "title": "Chat",
      "component": "ChatLayout",
      "content": "content/chat.json",
      "regions": [
        {
          "id": "sidebar"
        },
        {
          "id": "header"
        },
        {
          "id": "conversation"
        },
        {
          "id": "composer"
        }
      ],
      "docs": {
        "summary": "A conversation with its history, built on F15.70.",
        "narrow": "The sidebar starts closed and floats over the conversation when opened (Escape closes it); the column takes the whole width.",
        "try": [
          "Send a message: the ring turns, a few working steps show, then the words stream in; Stop ends the reply where it is.",
          "Choose Create image from the + menu, then send: the picture is drawn in the reply.",
          "Under a reply: Copy, rate, Try again (the old version stays, with 1 / 2) or Branch into a new chat.",
          "Open “Summarise the release notes”: the failed reply offers Try again.",
          "In the sidebar: rename, share, archive (with Undo) or delete (asks first) a chat; Search chats; the account menu’s Settings."
        ],
        "notBuilt": [
          "The sidebar’s rail form and an account row pinned to its foot.",
          "Search as you type; editing a message in place.",
          "Voice mode, Canvas, maths, the whole-chat drop area and a Sources panel."
        ],
        "regions": [
          {
            "region": "Sidebar",
            "holds": "New chat, Search chats, the chats by date and project, the account",
            "uses": "ListItem, ConversationList, Persona, MenuButton"
          },
          {
            "region": "Header",
            "holds": "Sidebar toggle, model menu, Share or Temporary chat",
            "uses": "ChatLayout header, MenuButton, Button, Switch"
          },
          {
            "region": "Conversation",
            "holds": "Messages: thinking, words, tables, code, pictures, cards, sources, a failed reply",
            "uses": "ChatMessage, ChatThinking, MessageActions, ImageGeneration, DataTable, CodeBlock, Card, Alert"
          },
          {
            "region": "Composer",
            "holds": "Text, attachments, tools, Dictate, Send and Stop",
            "uses": "Composer"
          },
          {
            "region": "Dialogs",
            "holds": "Search, Share, Delete, Settings",
            "uses": "Dialog, TextField, List, Switch"
          }
        ]
      }
    },
