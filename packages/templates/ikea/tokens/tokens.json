      "chat-panel": {
        "fill": {
          "$type": "color",
          "$value": "{color.bg}",
          "$description": "The chat panel's body."
        },
        "head-fill": {
          "$type": "color",
          "$value": "{color.map.feature}",
          "$description": "The chat panel's head: the feature surface."
