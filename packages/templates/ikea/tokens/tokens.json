{
  "$description": "The IKEA store template's own part tokens (owner Q138): each aliases a core semantic role, so the parts follow the template theme (tokens/theme.json), every scheme and contrast.",
  "t": {
    "ikea": {
      "store-header": {
        "bar-fill": {
          "$type": "color",
          "$value": "{color.text}",
          "$description": "The utility bar above the header: the page's text colour as a fill, so it's near-black on a light page."
        },
        "bar-on": {
          "$type": "color",
          "$value": "{color.bg}",
          "$description": "Words and icons on the utility bar."
        },
        "bar-height": {
          "$type": "dimension",
          "$value": "{size.control-lg}",
          "$description": "The utility bar's height."
        },
        "bar-text": {
          "$type": "dimension",
          "$value": "{text.s}",
          "$description": "The utility bar's words."
        },
        "gap": {
          "$type": "dimension",
          "$value": "{space.inline-group}",
          "$description": "Between the wordmark, the search and the actions, and between the bar's links."
        },
        "row-padding": {
          "$type": "dimension",
          "$value": "{space.inset-md}",
          "$description": "Above and below the header's main row."
