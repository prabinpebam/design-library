            "type": "object"
          },
          "type": "array"
        },
        "currency": {
          "type": "string"
        },
        "delivery": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "type": "array"
        },
        "featured": {
          "description": "The product the product page opens on before anything is chosen.",
          "type": "string"
        },
        "footer": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "links": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "heading",
              "links"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "payment": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "type": "array"
        },
        "popular": {
          "description": "The products on the home page's \"Popular right now\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/Product"
          },
          "type": "array"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/Room"
          },
          "type": "array"
        },
        "services": {
          "description": "The home page's services and support: a semantic icon name, a title and one line.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "icon",
              "title",
              "text"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "store": {
          "type": "string"
        },
        "strings": {
          "$ref": "#/$defs/StoreStrings"
        }
      },
