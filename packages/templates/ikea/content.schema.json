{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/ikea/content/1",
  "title": "IKEA store content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/ikea/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "price": {
          "description": "The delivery price in whole units; 0 is free.",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "description": "The IKEA store template's record (owner Q137): the shop's catalogue, rooms, delivery and payment choices, and its words (content/shared.json).",
      "properties": {
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "finishes": {
          "description": "Its colours or finishes; the first is the one shown.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "What it is, in a few words: \"3-seat sofa, light grey\".",
          "type": "string"
        },
        "lowest": {
          "description": "One of the lowest prices: the price sits in the box of the brand's second colour.",
          "type": "boolean"
        },
        "measurements": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "description": "The product's name, set in capitals as the shop does.",
          "type": "string"
        },
        "picture": {
          "description": "The asset id of its picture.",
          "type": "string"
        },
        "price": {
          "description": "The price in the store's currency, in whole units.",
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "reviews": {
          "type": "number"
        },
        "tag": {
          "description": "A badge such as \"New\" or \"Lower price\".",
          "type": "string"
        },
        "was": {
          "description": "A lower earlier price, shown struck through when the product is on offer.",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "price",
        "rating",
        "reviews",
        "picture",
        "finishes",
        "description",
        "measurements"
      ],
      "type": "object"
    },
    "record.shared": {
      "$ref": "#/$defs/StoreRecord"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "The category its \"See all\" opens on the products page.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "picture": {
          "type": "string"
        },
        "products": {
          "description": "The products seen in the room's picture, shown under it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "picture",
        "category",
        "products"
      ],
      "type": "object"
    },
    "StoreRecord": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
