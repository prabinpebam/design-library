{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/word/content/1",
  "title": "Document editor content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/word/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WordRecord"
    },
    "WordBlock": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "title",
            "heading-1",
            "heading-2",
            "body"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "style",
        "text"
      ],
      "type": "object"
    },
    "WordCommand": {
      "additionalProperties": false,
      "description": "One ribbon command: a stacked lead command, an icon command (optionally with a menu chevron), or a value field.",
      "properties": {
        "icon": {
          "description": "A core icon name.",
          "type": "string"
        },
        "kind": {
          "description": "labelled: a small icon with its name beside it, on a ribbon row (Header, Breaks).",
          "enum": [
            "stacked",
            "icon",
            "labelled",
            "field"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "menu": {
          "description": "A split command with a menu of options.",
          "type": "boolean"
        },
        "pressed": {
          "description": "A toggle that's on (left alignment).",
          "type": "boolean"
        },
        "value": {
          "description": "A field's current value (\"Aptos (Body)\", \"12\").",
          "type": "string"
        },
        "width": {
          "description": "A field's width class: `wide` for a font name, `narrow` for a size.",
          "enum": [
            "wide",
            "narrow"
          ],
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "WordComment": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "description": "The words in the document the comment is anchored to.",
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "time",
        "text",
        "anchor"
      ],
      "type": "object"
    },
    "WordGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "launcher": {
          "type": "string"
        },
        "lead": {
          "description": "Lead commands stacked at the group's start (Paste).",
          "items": {
            "$ref": "#/$defs/WordCommand"
          },
          "type": "array"
        },
        "rows": {
          "description": "Rows of commands beside the lead ones.",
          "items": {
            "items": {
              "$ref": "#/$defs/WordCommand"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "WordRecord": {
      "additionalProperties": false,
      "properties": {
        "comments": {
          "items": {
            "$ref": "#/$defs/WordComment"
          },
          "type": "array"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "document": {
          "items": {
            "$ref": "#/$defs/WordBlock"
          },
          "type": "array"
        },
        "documentName": {
          "type": "string"
        },
        "home": {
          "items": {
            "$ref": "#/$defs/WordGroup"
          },
          "type": "array"
        },
        "saveState": {
          "type": "string"
        },
        "status": {
          "additionalProperties": false,
          "properties": {
            "accessibility": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "page": {
              "type": "string"
            },
            "predictions": {
              "type": "string"
            },
            "words": {
              "type": "string"
            },
            "zoom": {
              "type": "string"
            }
          },
          "required": [
            "page",
            "words",
            "language",
            "predictions",
            "accessibility",
            "zoom"
          ],
          "type": "object"
        },
        "tabs": {
          "description": "Ribbon tabs; each tab but Home carries its own groups (Home's are home).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "groups": {
                "items": {
                  "$ref": "#/$defs/WordGroup"
                },
                "type": "array"
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "documentName",
        "saveState",
        "user",
        "tabs",
        "home",
        "document",
        "comments",
        "status",
        "copy"
      ],
      "type": "object"
    }
  }
}
