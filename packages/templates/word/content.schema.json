{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/word/content/1",
  "title": "Document editor content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/word/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WordRecord"
    },
    "WordBlock": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "title",
            "heading-1",
            "heading-2",
            "body"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "style",
        "text"
      ],
      "type": "object"
    },
    "WordCommand": {
      "additionalProperties": false,
      "description": "One ribbon command: a stacked lead command, an icon command (optionally with a menu chevron), or a value field.",
      "properties": {
        "disabled": {
          "description": "Unavailable in the current selection state (Cut, Copy, Sensitivity on an empty selection).",
          "type": "boolean"
        },
        "icon": {
          "description": "Icon name from core or the template's custom icon pack.",
          "type": "string"
        },
        "kind": {
          "description": "labelled: a small icon with its name beside it; pen: a tall drawing tool; style-gallery: inline style-set thumbnail strip; separator: thin line between sets.",
          "enum": [
            "stacked",
            "icon",
            "labelled",
            "field",
            "separator",
            "pen",
            "style-gallery"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "lines": {
          "description": "Explicit multi-line stacked caption lines when a ribbon wraps at a specific break.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "menu": {
          "description": "A split command with a menu of options.",
          "type": "boolean"
        },
        "pressed": {
          "description": "A toggle that's on (left alignment).",
          "type": "boolean"
        },
        "value": {
          "description": "A field's current value (\"Aptos (Body)\", \"11\").",
          "type": "string"
        },
        "width": {
          "description": "A field's width class: `wide` for a font name, `narrow` for a size.",
          "enum": [
            "wide",
            "narrow"
          ],
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "WordComment": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "description": "The words in the document the comment is anchored to.",
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "time",
        "text",
        "anchor"
      ],
      "type": "object"
    },
    "WordCopilotPane": {
      "additionalProperties": false,
      "properties": {
        "allowEditing": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "menuLabel": {
          "type": "string"
        },
        "moreLabel": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "prompts": {
          "items": {
            "$ref": "#/$defs/WordCopilotPrompt"
          },
          "type": "array"
        }
      },
      "required": [
        "heading",
        "body",
        "prompts",
        "allowEditing",
        "placeholder",
        "menuLabel",
        "moreLabel"
      ],
      "type": "object"
    },
    "WordCopilotPrompt": {
      "additionalProperties": false,
      "properties": {
        "emphasis": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "prefix",
        "emphasis"
      ],
      "type": "object"
    },
    "WordGroup": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "description": "Multiple side-by-side stacks of command rows (Illustrations, Text).",
          "items": {
            "items": {
              "items": {
                "$ref": "#/$defs/WordCommand"
              },
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        "hideLabel": {
          "description": "Hides redundant group caption under a single-command collapsed group.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "launcher": {
          "type": "string"
        },
        "lead": {
          "description": "Lead commands stacked at the group's start (Paste).",
          "items": {
            "$ref": "#/$defs/WordCommand"
          },
          "type": "array"
        },
        "rows": {
          "description": "Rows of commands beside the lead ones.",
          "items": {
            "items": {
              "$ref": "#/$defs/WordCommand"
            },
            "type": "array"
          },
          "type": "array"
        },
        "trailLead": {
          "description": "Lead commands placed after an inline gallery (Colors, Fonts in Design).",
          "items": {
            "$ref": "#/$defs/WordCommand"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "WordRecord": {
      "additionalProperties": false,
      "properties": {
        "comments": {
          "items": {
            "$ref": "#/$defs/WordComment"
          },
          "type": "array"
        },
        "copilotPane": {
          "$ref": "#/$defs/WordCopilotPane"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "document": {
          "items": {
            "$ref": "#/$defs/WordBlock"
          },
          "type": "array"
        },
        "documentName": {
          "type": "string"
        },
        "home": {
          "items": {
            "$ref": "#/$defs/WordGroup"
          },
          "type": "array"
        },
        "saveState": {
          "type": "string"
        },
        "status": {
          "additionalProperties": false,
          "properties": {
            "accessibility": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "page": {
              "type": "string"
            },
            "predictions": {
              "type": "string"
            },
            "words": {
              "type": "string"
            },
            "zoom": {
              "type": "string"
            }
          },
          "required": [
            "page",
            "words",
            "language",
            "predictions",
            "accessibility",
            "zoom"
          ],
          "type": "object"
        },
        "styleSets": {
          "items": {
            "$ref": "#/$defs/WordStyleSet"
          },
          "type": "array"
        },
        "tabs": {
          "description": "Ribbon tabs; each tab but Home carries its own groups (Home's are home).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "groups": {
                "items": {
                  "$ref": "#/$defs/WordGroup"
                },
                "type": "array"
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "documentName",
        "saveState",
        "user",
        "tabs",
        "home",
        "document",
        "comments",
        "status",
        "copy"
      ],
      "type": "object"
    },
    "WordStyleSet": {
      "additionalProperties": false,
      "properties": {
        "headingText": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "titleText": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "default",
            "caps-blue",
            "caps-rule",
            "serif",
            "caps-dark",
            "bar-num",
            "numbered",
            "caps-centered",
            "warm",
            "boxed",
            "minimal",
            "bold-sans",
            "editorial",
            "classic",
            "slate",
            "compact"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "titleText",
        "headingText",
        "variant"
      ],
      "type": "object"
    }
  }
}
