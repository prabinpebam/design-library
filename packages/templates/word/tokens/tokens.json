{
  "$description": "The document editor template's own component tokens: each aliases a core semantic role, so its parts follow the theme and every context.",
  "t": {
    "word": {
      "window": {
        "gap": {
          "$type": "dimension",
          "$value": "{space.inset-sm}",
          "$description": "Around the ribbon card and between the window's own parts."
        },
        "frame-border": {
          "$type": "color",
          "$value": "{color.border-strong}",
          "$description": "Window frame border (#DCDCDC/#336DC4 light, #6D6D6E dark)."
        },
        "surface": {
          "$type": "color",
          "$value": "{color.bg-control}",
          "$description": "Fields and document sheet (#FFFFFF light, #262626 dark)."
        },
        "search-bg": {
          "$type": "color",
          "$value": "{color.bg}",
          "$description": "Title-bar search box fill (#FAFAFA light, #1F1F1F dark)."
        },
        "ruler-inner": {
          "$type": "color",
          "$value": "{color.map.feature-tint}",
          "$description": "Ruler printable strip (#FFFFFF light, #25201C dark)."
        },
        "copilot-bg": {
          "$type": "color",
          "$value": "{color.map.band}",
          "$description": "Copilot right pane surface (#FAF9F8 light, #181818 dark)."
        },
        "copilot-fg": {
          "$type": "color",
          "$value": "{color.map.band-on}",
          "$description": "Copilot right pane text."
        },
        "copilot-chip": {
          "$type": "color",
          "$value": "{color.map.chip-tint}",
          "$description": "Copilot prompt suggestion chips (#EFEFEF light, #2E2E2E dark)."
        },
        "border": {
          "$type": "color",
          "$value": "{color.border}",
          "$description": "Hairlines on rulers, draft pill and ribbon."
        },
        "border-strong": {
          "$type": "color",
          "$value": "{color.border-strong}",
          "$description": "Page sheet edge and chrome control borders."
        },
        "muted": {
          "$type": "color",
          "$value": "{color.text-muted}",
          "$description": "Ruler numbers and draft prompt text."
        },
        "badge-dot": {
          "$type": "color",
          "$value": "{color.promo.offer}",
          "$description": "Notification dot on the plan button (#D13438)."
        },
        "mica-end": {
          "$type": "color",
          "$value": "{color.map.nav-hover}",
          "$description": "Right-side title bar Mica gradient stop."
        },
        "tab-wash": {
          "$type": "color",
          "$value": "{color.map.nav-selected}",
          "$description": "Tab strip background wash."
        },
        "status-seam": {
          "$type": "color",
          "$value": "{color.map.feature}",
          "$description": "Status bar top seam."
        },
        "mark-primary": {
          "$type": "color",
          "$value": "{color.category.1}",
          "$description": "App tile primary spine."
        },
        "mark-secondary": {
          "$type": "color",
          "$value": "{color.category.2}",
          "$description": "App tile secondary page stripe."
        },
        "icon-green": {
          "$type": "color",
          "$value": "{color.category.3}",
          "$description": "Green accent on comment-new, add-pen, smartart and set-default icons."
        }
      }
    }
  }
}
