  "contentVersion": 1,
  "shared": "content/shared.json",
  "assets": "assets.json",
  "home": "home",
  "sections": [
    {
      "id": "event",
      "title": "The event",
      "summary": "What the event is, where it happens, who backs it, and a way back from a missing page.",
      "flows": [
        {
          "id": "discover",
          "title": "Discover the event",
          "summary": "Know what the event is and why to come.",
          "screens": [
            "home",
            "about-event"
          ]
        },
        {
          "id": "visit",
          "title": "Plan the visit",
          "summary": "Find the venue, get there and stay nearby, with answers to common questions.",
          "screens": [
            "venue",
            "travel",
            "faq"
          ]
        },
        {
          "id": "sponsors",
          "title": "See the sponsors",
          "summary": "Who makes the event possible.",
          "screens": [
            "sponsors"
          ]
        },
        {
          "id": "sponsor",
          "title": "Become a sponsor",
          "summary": "Ask for the sponsorship pack.",
          "screens": [
            "become-sponsor"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and the way on.",
          "screens": [
            "not-found"
          ]
        }
      ]
    },
    {
      "id": "programme",
      "title": "Programme",
      "summary": "The sessions, the people on stage, your own schedule and the day as it happens.",
      "flows": [
        {
          "id": "programme",
          "title": "Plan your days",
          "summary": "See the programme and read one session.",
          "screens": [
            "schedule",
            "session"
          ]
        },
        {
          "id": "speakers",
          "title": "Speakers and talks",
          "summary": "Meet the speakers, then propose a talk and follow its review.",
          "screens": [
            "speakers",
            "speaker",
            "cfp",
            "submit-talk",
            "submission"
          ]
        },
        {
          "id": "agenda",
          "title": "Build your agenda",
          "summary": "Keep the sessions you want to see.",
          "screens": [
            "my-schedule"
          ]
        },
        {
          "id": "live",
          "title": "Follow it live",
          "summary": "What is on now and next.",
          "screens": [
            "live"
          ]
        }
      ]
    },
    {
      "id": "tickets",
      "title": "Tickets",
      "summary": "Buy, manage and book tickets for a group, and sign in to see them.",
      "flows": [
        {
          "id": "buy",
          "title": "Buy tickets",
          "summary": "Choose tickets, name the attendees, pay and get the order.",
          "screens": [
            "tickets",
            "attendee-details",
            "payment",
            "sold-out"
          ]
        },
        {
          "id": "manage",
          "title": "Manage your tickets",
          "summary": "See your tickets and pass one on.",
          "screens": [
            "my-tickets",
            "transfer-ticket"
          ]
        },
        {
          "id": "group",
          "title": "Book for a team",
          "summary": "Ask for a group price.",
          "screens": [
            "group-booking"
          ]
        },
        {
          "id": "sign-in",
          "title": "Sign in",
          "summary": "Sign in with the email on the ticket.",
          "screens": [
            "sign-in"
          ]
        }
      ]
    }
  ],
