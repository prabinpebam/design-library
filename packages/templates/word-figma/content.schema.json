{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/word-figma/content/1",
  "title": "Document editor in design-tool chrome content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/word-figma/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "CoreIconName": {
      "enum": [
        "check",
        "close",
        "chevron-start",
        "chevron-end",
        "chevron-down",
        "external",
        "info",
        "success",
        "warning",
        "error",
        "plus",
        "minus",
        "search",
        "menu",
        "scheme-light",
        "scheme-dark",
        "scheme-system",
        "contrast-standard",
        "contrast-more",
        "settings",
        "comment",
        "thumb-up",
        "thumb-down",
        "retry",
        "speaker",
        "branch",
        "copy",
        "person",
        "people",
        "organisation",
        "bot",
        "pause",
        "play",
        "more",
        "trend-up",
        "trend-down",
        "trend-flat",
        "image",
        "edit",
        "file",
        "pointer",
        "hand",
        "frame",
        "rectangle",
        "ellipse",
        "text",
        "layers",
        "properties",
        "board",
        "list",
        "grid",
        "upload",
        "mic",
        "arrow-up",
        "stop",
        "globe",
        "heart",
        "bag",
        "bag-add",
        "delivery",
        "store",
        "tag",
        "align-left",
        "align-h-center",
        "align-right",
        "align-top",
        "align-v-center",
        "align-bottom",
        "distribute-h",
        "distribute-v",
        "text-start",
        "text-center",
        "text-end",
        "text-justify",
        "eye",
        "eye-off",
        "lock",
        "unlock",
        "pen",
        "arrow-down",
        "arrow-end",
        "wrap",
        "corners",
        "sides",
        "layout-free",
        "layout-stack",
        "padding-horizontal",
        "padding-vertical",
        "resize-fit",
        "opacity",
        "link",
        "rotate",
        "code",
        "component",
        "constraint-h",
        "constraint-v",
        "size-width",
        "size-height",
        "stroke-position",
        "blend",
        "send",
        "at",
        "emoji",
        "more-vertical",
        "caret-down",
        "text-format",
        "headphones",
        "bold",
        "italic",
        "underline",
        "strikethrough",
        "subscript",
        "superscript",
        "clear-format",
        "text-larger",
        "text-smaller",
        "text-colour",
        "highlight",
        "fill-colour",
        "borders",
        "list-bulleted",
        "list-numbered",
        "indent-increase",
        "indent-decrease",
        "line-spacing",
        "sort",
        "pilcrow",
        "text-effects",
        "phonetic-guide",
        "character-border",
        "character-shading",
        "enclosed-character",
        "list-multilevel",
        "text-distributed",
        "character-spacing",
        "paste",
        "cut",
        "format-painter",
        "undo",
        "redo",
        "save",
        "share",
        "open-dialog",
        "book",
        "clock",
        "emoji-add",
        "leaf",
        "food",
        "ball",
        "plane",
        "lightbulb",
        "flag",
        "hash",
        "person-add",
        "home",
        "messages",
        "bell",
        "check-circle",
        "star",
        "bookmark",
        "pin",
        "inbox",
        "contacts",
        "sidebar",
        "help",
        "video",
        "captions",
        "quote",
        "code-block",
        "shortcut",
        "filter-lines",
        "window-maximize",
        "window-restore",
        "arrow-start",
        "compose",
        "forward",
        "list-search",
        "hash-box"
      ],
      "type": "string"
    },
    "CustomIconName": {
      "description": "A template's own icon name from a `--custom` pack, typed by `defineIconPack` (LG8): it reaches `Icon` without a cast.",
      "type": "string"
    },
    "IconName": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoreIconName"
        },
        {
          "$ref": "#/$defs/CustomIconName"
        }
      ],
      "description": "A semantic name the library draws, or a template's own name typed by `defineIconPack`."
    },
    "record.shared": {
      "$ref": "#/$defs/WordFigmaRecord"
    },
    "WfBlock": {
      "additionalProperties": false,
      "description": "A block of the document: its paragraph style and its words.",
      "properties": {
        "style": {
          "enum": [
            "title",
            "heading-1",
            "heading-2",
            "body",
            "quote"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "style",
        "text"
      ],
      "type": "object"
    },
    "WfComment": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "WfMenuItem": {
      "additionalProperties": false,
      "description": "One main-menu entry; an entry with `items` opens a submenu (File, Edit, View …).",
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "shortcut": {
                "type": "string"
              },
              "startsGroup": {
                "type": "boolean"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "shortcut": {
          "type": "string"
        },
        "startsGroup": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "WfOption": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "WfThread": {
      "additionalProperties": false,
      "description": "A comment thread, pinned to the words it's about (`anchor`).",
      "properties": {
        "anchor": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "replies": {
          "items": {
            "$ref": "#/$defs/WfComment"
          },
          "type": "array"
        },
        "resolved": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "author",
        "id",
        "replies",
        "text",
        "time"
      ],
      "type": "object"
    },
    "WfTool": {
      "additionalProperties": false,
      "description": "A tool in the bar; `menu` makes it a flyout (Insert's table, page break, date …).",
      "properties": {
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "label": {
          "type": "string"
        },
        "menu": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/IconName"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label",
              "icon"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "icon"
      ],
      "type": "object"
    },
    "WordFigmaRecord": {
      "additionalProperties": false,
      "properties": {
        "alignments": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "colours": {
          "description": "Text colours and highlights: a name and a CSS colour (the document's own palette, not interface colours).",
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Every interface word; `{name}` marks a value filled in.",
          "type": "object"
        },
        "document": {
          "items": {
            "$ref": "#/$defs/WfBlock"
          },
          "type": "array"
        },
        "file": {
          "description": "The document's name and its project, at the top of the left panel.",
          "type": "string"
        },
        "fonts": {
          "description": "Font families the Text section offers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "highlights": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "lineHeights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "lists": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "margins": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "me": {
          "description": "Who writes new comments and replies in the example.",
          "type": "string"
        },
        "menu": {
          "items": {
            "$ref": "#/$defs/WfMenuItem"
          },
          "type": "array"
        },
        "modes": {
          "description": "The mode switch at the bar's end: Edit, Read.",
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "orientations": {
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "people": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "presence": {
                "enum": [
                  "available",
                  "away"
                ],
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        },
        "sizes": {
          "description": "Font sizes in points the size field lists.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "styles": {
          "description": "Paragraph styles, by the tag they set: `p`, `h1`, `h2`, `h3`, `blockquote`.",
          "items": {
            "$ref": "#/$defs/WfOption"
          },
          "type": "array"
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/WfThread"
          },
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/WfTool"
          },
          "type": "array"
        },
        "zooms": {
          "description": "Zoom steps, as shares of 1.",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "file",
        "project",
        "people",
        "me",
        "menu",
        "tools",
        "modes",
        "zooms",
        "fonts",
        "sizes",
        "styles",
        "colours",
        "highlights",
        "lineHeights",
        "alignments",
        "lists",
        "cases",
        "margins",
        "orientations",
        "columns",
        "document",
        "threads",
        "copy"
      ],
      "type": "object"
    }
  }
}
