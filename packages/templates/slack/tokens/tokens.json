{
  "$description": "The Slack workspace template's own component tokens: each aliases a core semantic role, so its parts follow the theme and every context.",
  "t": {
    "slack": {
      "workspace": {
        "gap": {
          "$type": "dimension",
          "$value": "{space.stack-item}",
          "$description": "Between the Workspace's own parts."
        },
        "rail-tile-radius": {
          "$type": "dimension",
          "$value": "{radius.lg}",
          "$description": "The rail's current tile: the theme's large radius, resolved on the template root so the compact rail keeps it."
        },
        "composer-radius": {
          "$type": "dimension",
          "$value": "{radius.md}",
          "$description": "The three-band message composer card radius."
        },
        "rail-tile-tracking": {
          "$type": "dimension",
          "$value": "-0.02em",
          "$description": "Workspace rail tile initials: tight tracking.",
          "$extensions": {
            "org.design-library": {
              "measured": "Q143 reference spec, .design-library/slack-ref/README.md"
            }
          }
        },
        "rail-label-size": {
          "$type": "dimension",
          "$value": "0.6875rem",
          "$description": "Rail item labels under the tiles: 11 px.",
          "$extensions": {
            "org.design-library": {
              "measured": "Q143 reference spec, .design-library/slack-ref/README.md"
            }
          }
        },
        "badge-size": {
          "$type": "dimension",
          "$value": "0.625rem",
          "$description": "Unread count badges: 10 px.",
          "$extensions": {
            "org.design-library": {
              "measured": "Q143 reference spec, .design-library/slack-ref/README.md"
            }
          }
        },
        "hero-title-size": {
          "$type": "dimension",
          "$value": "1.6875rem",
          "$description": "Welcome hero title: 27 px.",
          "$extensions": {
            "org.design-library": {
              "measured": "Q143 reference spec, .design-library/slack-ref/README.md"
            }
          }
        },
        "disclaimer-size": {
          "$type": "dimension",
          "$value": "0.6875rem",
          "$description": "Slackbot prompt disclaimer: 11 px.",
          "$extensions": {
            "org.design-library": {
              "measured": "Q143 reference spec, .design-library/slack-ref/README.md"
            }
          }
        }
      }
    }
  }
}
