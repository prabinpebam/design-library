{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/slack/content/1",
  "title": "Slack workspace content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/slack/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WorkspaceRecord"
    },
    "WorkspaceIcon": {
      "enum": [
        "organisation",
        "comment",
        "speaker",
        "file",
        "more",
        "list",
        "edit",
        "frame",
        "person",
        "plus",
        "thumb-up",
        "heart"
      ],
      "type": "string"
    },
    "WorkspaceMessage": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "file": {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "detail"
          ],
          "type": "object"
        },
        "grouped": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "isNew": {
          "type": "boolean"
        },
        "reactions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "number"
              },
              "emoji": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "emoji",
              "label",
              "count"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "unfurl": {
          "additionalProperties": false,
          "properties": {
            "site": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "site",
            "text"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "currentUser": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "rail": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/WorkspaceIcon"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "icon"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "icon": {
                      "$ref": "#/$defs/WorkspaceIcon"
                    },
                    "mentions": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "presence": {
                      "enum": [
                        "available",
                        "away"
                      ],
                      "type": "string"
                    },
                    "unread": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "items"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "currentUser",
        "channel",
        "topic",
        "date",
        "rail",
        "sections",
        "messages",
        "replies",
        "copy"
      ],
      "type": "object"
    }
  }
}
