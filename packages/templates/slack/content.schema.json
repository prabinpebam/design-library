{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/slack/content/1",
  "title": "Slack workspace content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/slack/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WorkspaceRecord"
    },
    "WorkspaceEmoji": {
      "additionalProperties": false,
      "properties": {
        "char": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "char",
        "label"
      ],
      "type": "object"
    },
    "WorkspaceIcon": {
      "enum": [
        "organisation",
        "comment",
        "speaker",
        "file",
        "more",
        "list",
        "edit",
        "frame",
        "person",
        "plus",
        "thumb-up",
        "heart",
        "headphones",
        "hash",
        "person-add",
        "clock",
        "emoji",
        "leaf",
        "food",
        "ball",
        "plane",
        "lightbulb",
        "flag"
      ],
      "type": "string"
    },
    "WorkspaceMenuItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "label": {
          "type": "string"
        },
        "startsGroup": {
          "type": "boolean"
        },
        "tone": {
          "const": "danger",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "WorkspaceMessage": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "file": {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "detail"
          ],
          "type": "object"
        },
        "grouped": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "isNew": {
          "type": "boolean"
        },
        "reactions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "number"
              },
              "emoji": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "emoji",
              "label",
              "count"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "unfurl": {
          "additionalProperties": false,
          "properties": {
            "site": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "site",
            "text"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "createMenu": {
          "items": {
            "$ref": "#/$defs/WorkspaceMenuItem"
          },
          "type": "array"
        },
        "currentUser": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "emojiPicker": {
          "additionalProperties": false,
          "properties": {
            "categories": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "icon": {
                    "$ref": "#/$defs/WorkspaceIcon"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "icon"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "groups": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "items": {
                      "$ref": "#/$defs/WorkspaceEmoji"
                    },
                    "type": "array"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "items"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "handy": {
              "items": {
                "$ref": "#/$defs/WorkspaceEmoji"
              },
              "type": "array"
            }
          },
          "required": [
            "categories",
            "groups",
            "handy"
          ],
          "type": "object"
        },
        "memberCount": {
          "type": "number"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "messageMenu": {
          "items": {
            "$ref": "#/$defs/WorkspaceMenuItem"
          },
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "rail": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/WorkspaceIcon"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "icon"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "icon": {
                      "$ref": "#/$defs/WorkspaceIcon"
                    },
                    "mentions": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "presence": {
                      "enum": [
                        "available",
                        "away"
                      ],
                      "type": "string"
                    },
                    "unread": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "items"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "currentUser",
        "channel",
        "topic",
        "members",
        "memberCount",
        "date",
        "rail",
        "sections",
        "messages",
        "replies",
        "messageMenu",
        "createMenu",
        "emojiPicker",
        "copy"
      ],
      "type": "object"
    }
  }
}
