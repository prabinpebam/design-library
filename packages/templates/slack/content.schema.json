{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/slack/content/1",
  "title": "Slack workspace content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/slack/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WorkspaceRecord"
    },
    "WorkspaceChannelItem": {
      "additionalProperties": false,
      "properties": {
        "avatar": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "mentions": {
          "type": "number"
        },
        "mentionsLabel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "presence": {
          "enum": [
            "available",
            "away"
          ],
          "type": "string"
        },
        "unread": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WorkspaceEmoji": {
      "additionalProperties": false,
      "properties": {
        "char": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "char",
        "label"
      ],
      "type": "object"
    },
    "WorkspaceIcon": {
      "enum": [
        "organisation",
        "comment",
        "speaker",
        "file",
        "more",
        "list",
        "edit",
        "frame",
        "person",
        "people",
        "plus",
        "thumb-up",
        "heart",
        "headphones",
        "hash",
        "person-add",
        "clock",
        "emoji",
        "leaf",
        "food",
        "ball",
        "plane",
        "lightbulb",
        "flag",
        "home",
        "messages",
        "bell",
        "check-circle",
        "star",
        "bookmark",
        "pin",
        "inbox",
        "contacts",
        "sidebar",
        "help",
        "video",
        "quote",
        "code-block",
        "shortcut",
        "filter-lines",
        "window-maximize",
        "layers",
        "grid",
        "bot",
        "search",
        "settings",
        "external",
        "play",
        "arrow-start",
        "compose",
        "forward",
        "list-search",
        "hash-box",
        "bold",
        "italic",
        "underline",
        "strikethrough",
        "pilcrow",
        "link",
        "list-numbered",
        "list-bulleted",
        "code",
        "mic",
        "send",
        "chevron-down",
        "chevron-start",
        "chevron-end",
        "close",
        "minus",
        "menu",
        "scheme-dark",
        "text-format",
        "emoji-add",
        "more-vertical",
        "caret-down",
        "globe",
        "book",
        "arrow-end"
      ],
      "type": "string"
    },
    "WorkspaceMenuItem": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "highlighted": {
          "type": "boolean"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "inset": {
          "type": "boolean"
        },
        "items": {
          "description": "A submenu opened beside the item.",
          "items": {
            "$ref": "#/$defs/WorkspaceSubmenuItem"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "meta": {
          "type": "string"
        },
        "plate": {
          "description": "A round plate behind the icon: neutral, or a category 1-8 the theme tints.",
          "enum": [
            "neutral",
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "type": [
            "string",
            "number"
          ]
        },
        "shortcut": {
          "type": "string"
        },
        "startsGroup": {
          "type": "boolean"
        },
        "tone": {
          "const": "danger",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "WorkspaceMessage": {
      "additionalProperties": false,
      "properties": {
        "afterLinkText": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "dateAbove": {
          "type": "string"
        },
        "edited": {
          "type": "boolean"
        },
        "file": {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
