{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/slack/content/1",
  "title": "Slack workspace content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/slack/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "record.shared": {
      "$ref": "#/$defs/WorkspaceRecord"
    },
    "WorkspaceChannelItem": {
      "additionalProperties": false,
      "properties": {
        "avatar": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "mentions": {
          "type": "number"
        },
        "mentionsLabel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "presence": {
          "enum": [
            "available",
            "away"
          ],
          "type": "string"
        },
        "unread": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WorkspaceEmoji": {
      "additionalProperties": false,
      "properties": {
        "char": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "char",
        "label"
      ],
      "type": "object"
    },
    "WorkspaceIcon": {
      "enum": [
        "organisation",
        "comment",
        "speaker",
        "file",
        "more",
        "list",
        "edit",
        "frame",
        "person",
        "plus",
        "thumb-up",
        "heart",
        "headphones",
        "hash",
        "person-add",
        "clock",
        "emoji",
        "leaf",
        "food",
        "ball",
        "plane",
        "lightbulb",
        "flag",
        "home",
        "messages",
        "bell",
        "check-circle",
        "star",
        "bookmark",
        "pin",
        "inbox",
        "contacts",
        "sidebar",
        "help",
        "video",
        "quote",
        "code-block",
        "shortcut",
        "filter-lines",
        "window-maximize",
        "layers",
        "grid",
        "bot",
        "search",
        "settings",
        "external",
        "play"
      ],
      "type": "string"
    },
    "WorkspaceMenuItem": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "items": {
          "description": "A submenu opened beside the item.",
          "items": {
            "$ref": "#/$defs/WorkspaceSubmenuItem"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "plate": {
          "description": "A round plate behind the icon: neutral, or a category 1-8 the theme tints.",
          "enum": [
            "neutral",
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "type": [
            "string",
            "number"
          ]
        },
        "shortcut": {
          "type": "string"
        },
        "startsGroup": {
          "type": "boolean"
        },
        "tone": {
          "const": "danger",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "WorkspaceMessage": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "dateAbove": {
          "type": "string"
        },
        "edited": {
          "type": "boolean"
        },
        "file": {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "detail"
          ],
          "type": "object"
        },
        "grouped": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "isNew": {
          "type": "boolean"
        },
        "linkText": {
          "type": "string"
        },
        "mention": {
          "type": "string"
        },
        "reactions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "number"
              },
              "emoji": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "emoji",
              "label",
              "count"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "type": "number"
        },
        "replyAvatars": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statusEmoji": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "unfurl": {
          "$ref": "#/$defs/WorkspaceUnfurl"
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "additionalProperties": false,
      "properties": {
        "amaChannel": {
          "additionalProperties": false,
          "properties": {
            "activityMentions": {
              "type": "number"
            },
            "channel": {
              "type": "string"
            },
            "channelBadges": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "memberCountText": {
              "type": "string"
            },
            "messages": {
              "items": {
                "$ref": "#/$defs/WorkspaceMessage"
              },
              "type": "array"
            },
            "tabs": {
              "items": {
                "$ref": "#/$defs/WorkspaceTabItem"
              },
              "type": "array"
            },
            "topicText": {
              "type": "string"
            }
          },
          "required": [
            "channel",
            "topicText",
            "memberCountText",
            "activityMentions",
            "tabs",
            "channelBadges",
            "messages"
          ],
          "type": "object"
        },
        "channel": {
          "type": "string"
        },
        "channelMenu": {
          "items": {
            "$ref": "#/$defs/WorkspaceMenuItem"
          },
          "type": "array"
        },
        "copy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "createMenu": {
          "items": {
            "$ref": "#/$defs/WorkspaceMenuItem"
          },
          "type": "array"
        },
        "currentUser": {
          "type": "string"
        },
        "currentUserAvatar": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "emojiPicker": {
          "additionalProperties": false,
          "properties": {
            "categories": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "icon": {
                    "$ref": "#/$defs/WorkspaceIcon"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "icon"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "groups": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "items": {
                      "$ref": "#/$defs/WorkspaceEmoji"
                    },
                    "type": "array"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "items"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "handy": {
              "items": {
                "$ref": "#/$defs/WorkspaceEmoji"
              },
              "type": "array"
            }
          },
          "required": [
            "categories",
            "groups",
            "handy"
          ],
          "type": "object"
        },
        "memberCountText": {
          "type": "string"
        },
        "members": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "avatar": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "avatar"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "messageMenu": {
          "items": {
            "$ref": "#/$defs/WorkspaceMenuItem"
          },
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "moreUnreadsLabel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "newMessagesBanner": {
          "type": "string"
        },
        "quickReactions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "emoji": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "emoji",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "rail": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/WorkspaceIcon"
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "mentions": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label",
              "icon"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "items": {
            "$ref": "#/$defs/WorkspaceMessage"
          },
          "type": "array"
        },
        "sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "collapsible": {
                "type": "boolean"
              },
              "items": {
                "items": {
                  "$ref": "#/$defs/WorkspaceChannelItem"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "items"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "tabs": {
          "items": {
            "$ref": "#/$defs/WorkspaceTabItem"
          },
          "type": "array"
        },
        "topicLink": {
          "type": "string"
        },
        "topicMiddle": {
          "type": "string"
        },
        "topicPrefix": {
          "type": "string"
        },
        "vipModal": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "emptyText": {
              "type": "string"
            },
            "listHeading": {
              "type": "string"
            },
            "remindLater": {
              "type": "string"
            },
            "save": {
              "type": "string"
            },
            "searchPlaceholder": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "description",
            "searchPlaceholder",
            "listHeading",
            "emptyText",
            "remindLater",
            "save"
          ],
          "type": "object"
        },
        "vipPrompt": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": "string"
            },
            "later": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "body",
            "later",
            "start"
          ],
          "type": "object"
        },
        "welcomePrompt": {
          "additionalProperties": false,
          "properties": {
            "cta": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "cta"
          ],
          "type": "object"
        },
        "workspaceBadge": {
          "type": "string"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceTile"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "workspaceBadge",
        "currentUser",
        "currentUserAvatar",
        "channel",
        "topicPrefix",
        "topicMiddle",
        "topicLink",
        "members",
        "memberCountText",
        "date",
        "moreUnreadsLabel",
        "vipPrompt",
        "welcomePrompt",
        "vipModal",
        "amaChannel",
        "workspaces",
        "rail",
        "tabs",
        "sections",
        "messages",
        "replies",
        "quickReactions",
        "messageMenu",
        "channelMenu",
        "createMenu",
        "emojiPicker",
        "copy"
      ],
      "type": "object"
    },
    "WorkspaceSubmenuItem": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "label": {
          "type": "string"
        },
        "plate": {
          "description": "A round plate behind the icon: neutral, or a category 1-8 the theme tints.",
          "enum": [
            "neutral",
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "type": [
            "string",
            "number"
          ]
        },
        "shortcut": {
          "type": "string"
        },
        "startsGroup": {
          "type": "boolean"
        },
        "tone": {
          "const": "danger",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "WorkspaceTabItem": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/WorkspaceIcon"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "icon"
      ],
      "type": "object"
    },
    "WorkspaceTile": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "mentions": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "tone": {
          "enum": [
            "coral",
            "sage"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "initials",
        "name",
        "tone"
      ],
      "type": "object"
    },
    "WorkspaceUnfurl": {
      "additionalProperties": false,
      "properties": {
        "banner": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "thumb": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "site",
        "text"
      ],
      "type": "object"
    }
  }
}
