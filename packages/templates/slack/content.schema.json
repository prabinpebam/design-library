          "required": [
            "name",
            "detail"
          ],
          "type": "object"
        },
        "grouped": {
          "type": "boolean"
        },
        "hovered": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "isNew": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "linkText": {
          "type": "string"
        },
        "mention": {
          "type": "string"
        },
        "reactions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "number"
              },
              "emoji": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "emoji",
              "label",
              "count"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "replies": {
          "type": "number"
        },
        "replyAvatars": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statusEmoji": {
          "type": "string"
        },
        "subText": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "unfurl": {
          "$ref": "#/$defs/WorkspaceUnfurl"
        }
      },
      "required": [
        "id",
        "author",
        "time",
        "text"
      ],
      "type": "object"
    },
    "WorkspaceRecord": {
      "additionalProperties": false,
