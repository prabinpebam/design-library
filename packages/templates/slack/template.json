{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "slack",
  "version": "0.1.0",
  "title": "Slack workspace",
  "summary": "A reference-led team workspace: channels, messages and threads on the public core.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "shared": "content/shared.json",
  "assets": "assets.json",
  "home": "channel",
  "sections": [
    { "id": "workspace", "title": "Workspace", "summary": "Read, reply and find a conversation.", "flows": [
      { "id": "converse", "title": "Conversations", "summary": "A channel, its replies and shared files.", "screens": ["channel", "thread", "files"] },
      { "id": "find", "title": "Find a message", "summary": "Search the workspace.", "screens": ["search"] }
    ] }
  ],
  "layouts": [
    { "id": "channel", "title": "Channel", "component": "SiteLayout", "content": "content/channel.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "thread", "title": "Thread", "component": "SiteLayout", "content": "content/workspace/thread.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "files", "title": "Files", "component": "SiteLayout", "content": "content/workspace/files.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "search", "title": "Search", "component": "SiteLayout", "content": "content/workspace/search.json", "regions": [{"id":"main","accepts":["*"]}] }
  ],
  "parts": { "layouts": [{ "name": "slack.Workspace", "source": "parts/layouts/Workspace.tsx" }] }
}
