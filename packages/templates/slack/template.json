{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "slack",
  "version": "0.1.0",
  "title": "Slack workspace",
  "summary": "A reference-led team workspace: channels, messages and threads on the public core.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "shared": "content/shared.json",
  "assets": "assets.json",
  "home": "channel",
  "sections": [
    { "id": "workspace", "title": "Workspace", "summary": "Read, reply and find a conversation.", "flows": [
      { "id": "converse", "title": "Conversations", "summary": "A channel, its replies, unreads and shared files.", "screens": ["channel", "unreads", "thread", "files"] },
      { "id": "browse", "title": "Browse workspace", "summary": "Directories, huddles and welcome catch-up.", "screens": ["directories", "huddles", "welcome-back"] },
      { "id": "actions", "title": "Channel actions and VIPs", "summary": "Prioritize VIPs and manage channel settings.", "screens": ["vip-modal", "channel-menu"] },
      { "id": "find", "title": "Find a message", "summary": "Search the workspace.", "screens": ["search"] }
    ] }
  ],
  "layouts": [
    { "id": "channel", "title": "Channel", "component": "SiteLayout", "content": "content/channel.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "vip-modal", "title": "VIP modal", "component": "SiteLayout", "content": "content/workspace/vip-modal.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "channel-menu", "title": "Channel menu", "component": "SiteLayout", "content": "content/workspace/channel-menu.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "directories", "title": "Directories", "component": "SiteLayout", "content": "content/workspace/browse/directories.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "huddles", "title": "Huddles", "component": "SiteLayout", "content": "content/workspace/browse/huddles.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "unreads", "title": "Unreads", "component": "SiteLayout", "content": "content/workspace/converse/unreads.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "welcome-back", "title": "Welcome back", "component": "SiteLayout", "content": "content/workspace/browse/welcome-back.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "thread", "title": "Thread", "component": "SiteLayout", "content": "content/workspace/converse/thread.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "files", "title": "Files", "component": "SiteLayout", "content": "content/workspace/converse/files.json", "regions": [{"id":"main","accepts":["*"]}] },
    { "id": "search", "title": "Search", "component": "SiteLayout", "content": "content/workspace/search.json", "regions": [{"id":"main","accepts":["*"]}] }
  ],
  "parts": { "layouts": [{ "name": "slack.Workspace", "source": "parts/layouts/Workspace.tsx" }] }
}
