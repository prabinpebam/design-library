    "messages": [
      {
        "id": "m1",
        "author": "Maya Chen",
        "time": "9:12 AM",
        "text": "Morning, team! The updated direction for our autumn collection is ready for a look. I brought the notes from yesterday into one place.",
        "reactions": [
          {
            "emoji": "👍",
            "label": "Like",
            "count": 4
          },
          {
            "emoji": "❤️",
            "label": "Love",
            "count": 2
          }
        ],
        "replies": 4
      },
      {
        "id": "m2",
        "author": "Maya Chen",
        "time": "9:13 AM",
        "text": "The main change is a calmer opening and more room for the work. Let me know what feels right.",
        "grouped": true
      },
      {
        "id": "m3",
        "author": "Alex Rivera",
        "time": "9:24 AM",
        "text": "This feels much clearer. I put together a short outline for the review so we can spend more time on the details.",
        "file": {
          "name": "Studio review notes.pdf",
          "detail": "PDF · 248 KB"
        }
      },
      {
        "id": "m4",
        "author": "Sam Patel",
        "time": "9:31 AM",
        "text": "A small update from the build: the new navigation is in place. The notes below cover what changed and what to try.",
        "unfurl": {
          "title": "A new home for the studio",
          "site": "Fieldwork journal",
          "text": "The latest workspace update: a simpler way to find the conversations and projects that matter."
        },
        "reactions": [
          {
            "emoji": "👍",
            "label": "Like",
            "count": 3
          }
        ]
      },
      {
        "id": "m5",
        "author": "Jamie Park",
        "time": "10:02 AM",
        "text": "Thanks for bringing this together. I’ll review the opening this morning and leave a few thoughts in the thread.",
        "isNew": true
      },
      {
        "id": "m6",
        "author": "Maya Chen",
        "time": "10:05 AM",
        "text": "Perfect. We have time to explore both directions before the team review tomorrow.",
        "reactions": [
          {
            "emoji": "❤️",
            "label": "Love",
            "count": 1
          }
        ]
      },
      {
        "id": "m7",
        "author": "Maya Chen",
        "time": "10:06 AM",
        "text": "Thoughts on the opening are welcome in the thread too.",
        "grouped": true
      }
    ],
    "replies": [
      {
        "id": "r1",
        "author": "Alex Rivera",
        "time": "9:18 AM",
        "text": "The extra space around the opening makes such a difference. I’d keep that direction."
      },
      {
        "id": "r2",
        "author": "Sam Patel",
        "time": "9:22 AM",
        "text": "Agreed. I’ll check how the longer project names sit in the navigation."
      },
      {
        "id": "r3",
        "author": "Jamie Park",
        "time": "9:28 AM",
        "text": "I added the mobile notes to the review document."
      }
    ],
