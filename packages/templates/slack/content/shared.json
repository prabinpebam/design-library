            "title": "How to Attract and Scale Teams Quickly and Efficiently — Live Workshop",
            "site": "luma.com",
            "text": "One of the biggest challenges for growing teams is hiring well without heavy process. Join our live interactive session.",
            "thumb": "unfurlWorkshop"
          }
