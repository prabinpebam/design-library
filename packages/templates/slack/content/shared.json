    "messages": [
      {
        "id": "m1",
        "author": "Elena Rostova",
        "avatar": "avatar04",
        "time": "2:18 AM",
        "text": "Sharing the latest breakdown on hiring shifts across product, research, and systems roles this quarter.",
        "unfurl": {
          "title": "State of the tech job market: late 2026",
          "site": "fieldnotesnewsletter.com",
          "text": "PMs are steady, systems engineers are plateauing, craft roles are adapting, and the biggest hiring wave sits outside pure software.",
          "thumb": "unfurlSketches",
          "banner": "unfurlChart"
        },
        "replies": 4,
        "replyAvatars": ["avatar02", "avatar06"]
      },
      {
        "id": "m2",
        "author": "Marco Silva",
        "avatar": "avatar05",
        "time": "4:00 AM",
        "text": "This is an interesting article — maybe a bit dramatic in its framing, yet nonetheless it raises sharp points on team pace.",
        "linkText": "notes.marcosilva.org/p/why-small-teams-move-ahead",
        "unfurl": {
          "title": "Why small product teams are moving months ahead",
          "site": "notes.marcosilva.org",
          "text": "For ten years, a small group of practitioners predicted tighter loops between research and shipping. Now teams are seeing it firsthand.",
          "thumb": "unfurlSpeaker"
        },
        "replies": 2,
        "replyAvatars": ["avatar01", "avatar09"]
      },
      {
        "id": "m3",
        "author": "Nadia Okafor",
        "avatar": "avatar01",
        "time": "6:14 AM",
        "text": "Ran across a memorable phrase from a privacy researcher at Georgetown: “marketing by urgency”. Telling teams they have to adopt every tool overnight or fall behind? Yeah, that captures it.",
        "replies": 3,
        "replyAvatars": ["avatar03", "avatar07"]
      },
      {
        "id": "m4",
        "author": "Lukas Weber",
        "avatar": "avatar02",
        "time": "8:02 AM",
        "text": "Worth reading if anyone here works on booking or checkout flows:",
        "file": {
          "name": "Checkout-verification-brief.pdf",
          "detail": "PDF · 248 KB"
        },
        "unfurl": {
          "title": "Major Carriers Introduce New Rules for Automated Seat Booking",
          "site": "The Transit Journal",
          "text": "Carriers cite passenger data-privacy safeguards and fare-scraping load: “we don’t want an unverified middle layer.”",
          "thumb": "unfurlFlight"
        },
        "replies": 1,
        "replyAvatars": ["avatar10"]
      }
    ],
