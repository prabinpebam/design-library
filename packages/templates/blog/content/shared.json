              {
                "label": "Design systems",
                "href": "/index"
              },
              {
                "label": "Accessibility",
                "href": "/index"
              }
            ]
          },
          {
            "id": "about",
            "heading": "About",
            "links": [
              {
                "label": "Authors",
                "href": "/author"
              },
              {
                "label": "Write for us",
                "href": "/index"
              }
            ]
          }
        ],
        "links": [
          {
            "label": "Privacy",
            "href": "/index"
          },
          {
            "label": "Feed",
            "href": "/index"
