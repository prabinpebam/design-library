  "template": "blog",
  "layout": "sign-in",
  "contentVersion": 1,
  "settings": {
    "current": "index",
    "width": "reading"
  },
  "regions": {
    "main": [
      {
        "type": "form",
        "choose": "Choose one",
        "enter": "Enter {field}.",
