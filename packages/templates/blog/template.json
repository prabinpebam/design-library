{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "blog",
  "version": "1.0.0",
  "title": "Blog",
  "summary": "Articles to read, one article, and its author.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "shared": "content/shared.json",
  "assets": "assets.json",
  "home": "index",
  "sections": [
    {
      "id": "read",
      "title": "Read",
      "summary": "Finding and reading articles.",
      "flows": [
        {
          "id": "browse",
          "title": "Browse articles",
          "summary": "The latest articles and those on one topic.",
          "screens": [
            "index",
            "topic"
          ]
        },
        {
          "id": "archive",
          "title": "Browse the archive",
          "summary": "Every article by month.",
          "screens": [
            "archive"
          ]
        },
        {
          "id": "series",
          "title": "Follow a series",
          "summary": "Read a series in order.",
          "screens": [
            "series"
          ]
        },
        {
          "id": "article",
          "title": "Read an article",
          "summary": "Read one article and meet its author.",
          "screens": [
            "article",
            "author"
          ]
        }
      ]
    },
    {
      "id": "subscribe",
      "title": "Subscribe",
      "summary": "Getting new articles by email or feed.",
      "flows": [
        {
          "id": "newsletter",
          "title": "Join the newsletter",
          "summary": "Subscribe and confirm the address.",
          "screens": [
            "subscribe"
          ]
        },
        {
          "id": "manage",
          "title": "Manage email",
          "summary": "Choose what arrives, or stop it.",
          "screens": [
            "email-preferences",
            "unsubscribed"
          ]
        },
        {
          "id": "feed",
          "title": "Follow by feed",
          "summary": "Add the blog to a feed reader.",
          "screens": [
            "feeds"
          ]
        }
      ]
    },
    {
      "id": "reader",
      "title": "Reader account",
      "summary": "Signing in to save and discuss articles.",
      "flows": [
        {
          "id": "sign-in",
          "title": "Sign in",
          "summary": "Sign in with a link sent by email.",
          "screens": [
            "sign-in"
          ]
        },
        {
          "id": "comments",
          "title": "Join the discussion",
          "summary": "Read and write comments on an article.",
          "screens": [
            "comments"
          ]
        },
        {
          "id": "profile",
          "title": "Manage your profile",
          "summary": "Change name, picture and email.",
          "screens": [
            "reader-settings"
          ]
        },
        {
          "id": "report",
          "title": "Report a comment",
          "summary": "Tell the editors about a comment that breaks the house rules.",
          "screens": [
            "report-comment"
          ]
        }
      ]
    },
    {
      "id": "find",
      "title": "Find",
      "summary": "Search the articles, keep the ones to read later, and get back when a page is missing.",
      "flows": [
        {
          "id": "search",
          "title": "Search articles",
          "summary": "Find an article by what it says.",
          "screens": [
            "search"
          ]
        },
        {
          "id": "saved",
          "title": "Read later",
          "summary": "Come back to saved articles.",
          "screens": [
            "saved"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and the way back.",
          "screens": [
            "not-found"
          ]
        }
      ]
    }
  ],
