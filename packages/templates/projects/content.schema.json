{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/projects/content/1",
  "title": "Project management content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/projects/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "BadgeTone": {
      "enum": [
        "accent",
        "neutral",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "points": {
          "type": "number"
        },
        "sprint": {
          "description": "In the current sprint; otherwise waiting in the backlog.",
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/IssueType"
        }
      },
      "required": [
        "id",
        "key",
        "title",
        "type",
        "status",
        "points",
        "sprint"
      ],
      "type": "object"
    },
    "IssueDetail": {
      "additionalProperties": false,
      "properties": {
        "checklist": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "done": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "done"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "comments": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "when",
              "text"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "created": {
          "type": "string"
        },
        "description": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "reporter": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "checklist",
        "reporter",
        "created",
        "comments"
      ],
      "type": "object"
    },
    "IssueType": {
      "enum": [
        "Story",
        "Bug",
        "Task"
      ],
      "type": "string"
    },
    "ProjectRecord": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "type": "array"
        },
        "people": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "places": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        },
        "sprint": {
          "additionalProperties": false,
          "properties": {
            "ends": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "ends"
          ],
          "type": "object"
        },
        "statuses": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "limit": {
                "type": "number"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "strings": {
          "$ref": "#/$defs/ProjectStrings",
          "description": "Every interface word the screens show."
        },
        "types": {
          "additionalProperties": false,
          "properties": {
            "Bug": {
              "$ref": "#/$defs/BadgeTone"
            },
            "Story": {
              "$ref": "#/$defs/BadgeTone"
            },
            "Task": {
              "$ref": "#/$defs/BadgeTone"
            }
          },
          "required": [
            "Story",
            "Bug",
            "Task"
          ],
          "type": "object"
        }
      },
      "required": [
        "project",
        "sprint",
        "places",
        "people",
        "statuses",
        "types",
        "issues",
        "strings"
      ],
      "type": "object"
    },
    "ProjectStrings": {
      "additionalProperties": false,
      "description": "Interface words (Q64: every word a person reads is content). `{name}` marks a value filled in; `me` is the person using the app.",
      "properties": {
        "addComment": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "backlog": {
          "type": "string"
        },
        "backlogIntro": {
          "type": "string"
        },
        "backlogIssues": {
          "type": "string"
        },
        "cancel": {
          "type": "string"
        },
        "changesSaved": {
          "type": "string"
        },
        "checklist": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "createIssue": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "creatingIssues": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "descriptionHint": {
          "type": "string"
        },
        "doneCount": {
          "type": "string"
        },
        "doneWhen": {
          "type": "string"
        },
        "edit": {
          "description": "The issue's edit action (Q65 TP4) and its form, which takes the issue's place in the same box.",
          "type": "string"
        },
        "editIssue": {
          "type": "string"
        },
        "justNow": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "me": {
          "type": "string"
        },
        "notInExample": {
          "type": "string"
        },
        "planning": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "points": {
          "type": "string"
        },
        "pointsDone": {
          "type": "string"
        },
        "pointsHeader": {
          "type": "string"
        },
        "reporter": {
          "type": "string"
        },
        "saveChanges": {
          "type": "string"
        },
        "searchBoard": {
          "type": "string"
        },
        "softwareProject": {
          "type": "string"
        },
        "sprint": {
          "type": "string"
        },
        "sprintBoard": {
          "type": "string"
        },
        "sprintIntro": {
          "type": "string"
        },
        "sprintIssues": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleMissing": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "unassigned": {
          "type": "string"
        }
      },
      "required": [
        "point",
        "points",
        "key",
        "summary",
        "type",
        "status",
        "assignee",
        "pointsHeader",
        "unassigned",
        "sprintBoard",
        "backlog",
        "pointsDone",
        "sprintIntro",
        "sprintIssues",
        "backlogIntro",
        "backlogIssues",
        "description",
        "doneWhen",
        "doneCount",
        "checklist",
        "comments",
        "addComment",
        "comment",
        "justNow",
        "sprint",
        "reporter",
        "created",
        "softwareProject",
        "planning",
        "searchBoard",
        "createIssue",
        "creatingIssues",
        "notInExample",
        "me",
        "edit",
        "editIssue",
        "title",
        "titleMissing",
        "descriptionHint",
        "saveChanges",
        "cancel",
        "changesSaved"
      ],
      "type": "object"
    },
    "record.issue": {
      "$ref": "#/$defs/IssueDetail"
    },
    "record.shared": {
      "$ref": "#/$defs/ProjectRecord"
    }
  }
}
