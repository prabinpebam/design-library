{
  "$schema": "../../core/schemas/template.schema.json",
  "id": "projects",
  "version": "1.0.0",
  "title": "Project management",
  "summary": "Work tracked like Jira or Trello: a board, a backlog and an issue.",
  "contentSchema": "content.schema.json",
  "contentVersion": 1,
  "shared": "content/shared.json",
  "home": "board",
  "sections": [
    {
      "id": "plan",
      "title": "Plan and report",
      "summary": "Plan the work, and see how it’s going.",
      "flows": [
        {
          "id": "board",
          "title": "Run the board",
          "summary": "Move work across the columns.",
          "screens": [
            "board"
          ]
        },
        {
          "id": "backlog",
          "title": "Groom the backlog",
          "summary": "Order the backlog and plan a sprint from it.",
          "screens": [
            "backlog",
            "sprint-planning"
          ]
        },
        {
          "id": "roadmap",
          "title": "Shape the roadmap",
          "summary": "Place larger work on a timeline.",
          "screens": [
            "roadmap"
          ]
        },
        {
          "id": "reports",
          "title": "Read the reports",
          "summary": "Progress at a glance and over the sprint.",
          "screens": [
            "dashboard",
            "burndown"
          ]
        }
      ]
    },
    {
      "id": "track",
      "title": "Track",
      "summary": "Doing and finding the work.",
      "flows": [
        {
          "id": "issue",
          "title": "Work an issue",
          "summary": "Read an issue in full and change it.",
          "screens": [
            "issue"
          ]
        },
        {
          "id": "create",
          "title": "Report an issue",
          "summary": "Write up a new issue.",
          "screens": [
            "create-issue"
          ]
        },
        {
          "id": "mine",
          "title": "Do my work",
          "summary": "What is assigned to me.",
          "screens": [
            "my-work"
          ]
        },
        {
          "id": "search",
          "title": "Find issues",
          "summary": "Search and filter every issue.",
          "screens": [
            "issue-search"
          ]
        }
      ]
    },
    {
      "id": "team",
      "title": "Team and help",
      "summary": "Who's on the team, what's for you, and pages you can't reach.",
      "flows": [
        {
          "id": "members",
          "title": "Manage people",
          "summary": "See who is in the project and invite more.",
          "screens": [
            "members",
            "invite"
          ]
        },
        {
          "id": "inbox",
          "title": "Catch up",
          "summary": "Mentions, assignments and changes.",
          "screens": [
            "inbox"
          ]
        },
        {
          "id": "errors",
          "title": "Recover from an error",
          "summary": "Know what happened and the way back.",
          "screens": [
            "no-access",
            "not-found"
          ]
        }
      ]
    },
    {
      "id": "admin",
      "title": "Set-up",
      "summary": "Signing in and setting up a project.",
      "flows": [
        {
          "id": "sign-in",
          "title": "Sign in",
          "summary": "Sign in, then create the first project.",
          "screens": [
            "sign-in",
            "create-project"
          ]
        },
        {
          "id": "project",
          "title": "Set up the project",
          "summary": "Name, people and the workflow’s statuses.",
          "screens": [
            "project-settings",
            "workflow-settings"
          ]
        },
        {
          "id": "archive",
          "title": "Archive a project",
          "summary": "Close a finished project so it leaves every board, while keeping its history.",
          "screens": [
            "archive-project"
          ]
        }
      ]
    }
  ],
  "layouts": [
    {
      "id": "board",
      "title": "Board",
      "component": "AppLayout",
      "content": "content/board.json",
      "regions": [
        {
          "id": "sidebar"
        },
        {
          "id": "header"
        },
        {
          "id": "main"
        }
      ],
      "docs": {
        "summary": "This sprint’s issues as cards in columns by status, moved by dragging or a menu.",
        "narrow": "The sidebar starts closed and floats over the board when opened; the columns scroll sideways inside the board.",
        "try": [
          "Drag a card to In review: the column shows the accent outline only while you drag.",
          "Use a card’s Move menu (the three dots) to move it without dragging.",
          "Move a card to Done and watch the points done change; then open Backlog: its status changed there too.",
          "Search the board for “trip”.",
          "Open “Trip cards on the home screen” for the issue page."
        ],
        "notBuilt": [
          "Filters by person and type.",
          "Swimlanes.",
          "Creating and editing cards on the board.",
          "Reports and project settings."
        ],
        "regions": [
          {
            "region": "Sidebar",
            "holds": "The project, then Board and Backlog",
            "uses": "AppLayout, Persona, Navigation"
          },
          {
            "region": "Header",
            "holds": "Where you are, search this board, Create issue, your avatar",
            "uses": "Breadcrumbs, TextField (search), Button, Avatar"
          },
          {
            "region": "Sprint",
            "holds": "Its name, when it ends and points done",
            "uses": "Heading, Text"
          },
          {
            "region": "Board",
            "holds": "Four columns; each card’s key, title, type, points and assignee; In progress against its limit",
            "uses": "Board (new), Badge, Avatar, MenuButton"
          }
        ]
      }
    },
    {
      "id": "backlog",
