{
  "$description": "The coss template's theme (Q168): coss ui's look (cosscom/ui, MIT) through core tokens under [data-template='coss']. Values are read from its source (packages/ui/src/styles/globals.css and the component class lists, Tailwind v4 neutral palette) at desktop sizes (its sm: breakpoint), not copied files. Run npm run tokens after a change.",
  "font.ui": { "$value": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "Inter for everything (coss --font-sans)" },
  "font.text": { "$value": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "Inter for body text" },
  "font.display": { "$value": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "Inter for headings (coss --font-heading is the sans)" },
  "font.code": { "$value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "Geist Mono when installed, else the system monospace (Geist Mono isn't in the curated font list yet: a recorded gap)" },

  "color.bg": { "$value": { "light": "#ffffff", "dark": "#141414" }, "$description": "--background: white; neutral-950 mixed 96% with white in dark" },
  "color.bg-raised": { "$value": { "light": "#ffffff", "dark": "#1d1d1d" }, "$description": "--popover: menus, popovers and dialogs" },
  "color.bg-sunken": { "$value": { "light": "#fafafa", "dark": "#111111" }, "$description": "--sidebar: neutral-50; neutral-950 mixed 97% with white in dark" },
  "color.bg-tint": { "$value": { "light": "rgb(0 0 0 / 0.04)", "dark": "rgb(255 255 255 / 0.04)" }, "$description": "--muted, --secondary and --accent: black 4%, white 4% in dark" },
  "color.bg-control": { "$value": { "light": "#ffffff", "dark": "rgb(255 255 255 / 0.026)" }, "$description": "Inputs and outline buttons: --background; --input at 32% in dark" },
  "color.border-control": { "$value": { "light": "rgb(0 0 0 / 0.1)", "dark": "rgb(255 255 255 / 0.08)" }, "$description": "--input: a field's and an outline button's edge" },
  "color.border": { "$value": { "light": "rgb(0 0 0 / 0.08)", "dark": "rgb(255 255 255 / 0.06)" }, "$description": "--border: card edges and dividers" },
  "color.border-group": { "$value": { "light": "rgb(0 0 0 / 0.08)", "dark": "rgb(255 255 255 / 0.06)" }, "$description": "--border: a group's edge" },
  "color.border-strong": { "$value": { "light": "rgb(0 0 0 / 0.16)", "dark": "rgb(255 255 255 / 0.14)" }, "$description": "A stronger hairline where core asks for one (coss has none; derived from --input)" },
  "color.text": { "$value": { "light": "#262626", "dark": "#f5f5f5" }, "$description": "--foreground: neutral-800; neutral-100 in dark" },
  "color.text-muted": { "$value": { "light": "#686868", "dark": "#818181" }, "$description": "--muted-foreground: neutral-500 mixed 90% with black; with white in dark" },
  "color.text-link": { "$value": { "light": "#262626", "dark": "#f5f5f5" }, "$description": "Links are the foreground, underlined (the link button)" },
  "color.text-accent": { "$value": { "light": "#262626", "dark": "#f5f5f5" }, "$description": "No brand hue: accents are the foreground" },
  "color.text-accent-display": { "$value": { "light": "#262626", "dark": "#f5f5f5" }, "$description": "Headings stay the foreground" },
  "color.text-on-accent": { "$value": { "light": "#fafafa", "dark": "#262626" }, "$description": "--primary-foreground" },
  "color.accent": { "$value": { "light": "#262626", "dark": "#f5f5f5" }, "$description": "--primary: near-black; near-white in dark" },
  "color.accent-hover": { "$value": { "light": "#3c3c3c", "dark": "#dfdfdf" }, "$description": "bg-primary/90 on the background" },
  "color.accent-pressed": { "$value": { "light": "#3c3c3c", "dark": "#dfdfdf" }, "$description": "data-pressed:bg-primary/90" },
  "color.accent-subtle": { "$value": { "light": "rgb(0 0 0 / 0.04)", "dark": "rgb(255 255 255 / 0.04)" }, "$description": "--accent: a selected or hovered row" },
  "color.focus": { "$value": { "light": "#a1a1a1", "dark": "#737373" }, "$description": "--ring: neutral-400; neutral-500 in dark (below 3:1 on the background: coss's own value, recorded)" },
  "color.shadow": { "$value": { "light": "rgb(0 0 0 / 0.05)", "dark": "rgb(0 0 0 / 0.24)" }, "$description": "shadow-xs/5" },
  "shadow.raised": { "$value": "0 1px 2px var(--color-shadow)", "$description": "shadow-xs/5: controls and cards sit just above the page" },
  "shadow.overlay": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05)", "$description": "shadow-lg/5: menus, popovers and dialogs" },
  "state.hover": { "$value": { "light": "rgb(0 0 0 / 0.04)", "dark": "rgb(255 255 255 / 0.04)" }, "$description": "hover:bg-accent" },
  "state.pressed": { "$value": { "light": "rgb(0 0 0 / 0.06)", "dark": "rgb(255 255 255 / 0.06)" }, "$description": "A pressed ghost button" },
  "state.selected": { "$value": { "light": "rgb(0 0 0 / 0.04)", "dark": "rgb(255 255 255 / 0.04)" }, "$description": "--accent" },


  "color.map.action-fill": { "$value": "{color.accent}", "$description": "The primary button: --primary" },
  "color.map.action-fill-hover": { "$value": "{color.accent-hover}", "$description": "bg-primary/90" },
  "color.map.action-fill-pressed": { "$value": "{color.accent-pressed}", "$description": "data-pressed:bg-primary/90" },
  "color.map.action-fill-on": { "$value": "{color.text-on-accent}", "$description": "--primary-foreground" },
  "color.map.on-fill": { "$value": "{color.accent}", "$description": "A checked switch, checkbox, radio and a slider's fill: --primary" },
  "color.map.on-fill-hover": { "$value": "{color.accent-hover}", "$description": "bg-primary/90" },
  "color.map.mark-on-fill": { "$value": "{color.text-on-accent}", "$description": "The tick on a checked box" },
  "color.map.switch-handle": { "$value": { "light": "#ffffff", "dark": "#141414" }, "$description": "The thumb: bg-background" },
  "color.map.selection-indicator": { "$value": "{color.accent}", "$description": "The underline tab indicator: bg-primary" },
  "color.map.progress": { "$value": "{color.accent}", "$description": "Progress and meter fills: bg-primary" },
  "color.map.chosen-segment": { "$value": { "light": "#ffffff", "dark": "rgb(255 255 255 / 0.08)" }, "$description": "A chosen tab in a tab list: bg-background with a shadow; --input in dark" },
  "color.map.chosen-segment-on": { "$value": "{color.text}", "$description": "data-active:text-foreground" },
  "color.map.badge": { "$value": "{color.accent}", "$description": "The default badge: bg-primary" },
  "color.map.badge-on": { "$value": "{color.text-on-accent}", "$description": "text-primary-foreground" },
  "color.map.badge-tint": { "$value": "{color.bg-tint}", "$description": "The secondary badge: bg-secondary" },
  "color.map.chip": { "$value": "{color.accent}", "$description": "A selected filter: --primary" },
  "color.map.chip-tint": { "$value": "{color.bg-tint}", "$description": "bg-secondary" },
  "color.map.button-ring": { "$value": "{color.accent}", "$description": "A button's progress ring" },
  "color.map.brand-tint": { "$value": "{color.bg-tint}", "$description": "No brand hue: a tint is --accent" },

  "radius.sm": { "$value": "0.375rem", "$description": "rounded-sm 6 px: badges, menu items" },
  "radius.md": { "$value": "0.625rem", "$description": "rounded-lg 10 px (--radius): buttons, inputs, selects" },
  "radius.lg": { "$value": "0.875rem", "$description": "rounded-xl 14 px: menus, popovers and the docs' preview frames" },
  "c.button.radius": { "$value": "0.625rem", "$description": "rounded-lg 10 px" },
  "c.button.radius-sm": { "$value": "0.5rem", "$description": "xs buttons: rounded-md 8 px" },
  "c.button.radius-lg": { "$value": "0.625rem", "$description": "Large buttons keep rounded-lg" },
  "c.button.size-xs": { "$value": "1.5rem", "$description": "xs: h-6, 24 px" },
  "c.button.size-s": { "$value": "2rem", "$description": "default: h-8, 32 px" },
  "c.button.size": { "$value": "2.25rem", "$description": "lg: h-9, 36 px" },
  "c.button.size-m": { "$value": "2.5rem", "$description": "xl: h-10, 40 px" },
  "c.button.padding-inline": { "$value": "0.6875rem", "$description": "px-[calc(--spacing(3)-1px)] 11 px" },
  "c.button.padding-inline-sm": { "$value": "0.4375rem", "$description": "xs: 7 px" },
  "c.button.padding-inline-lg": { "$value": "0.8125rem", "$description": "lg: 13 px" },
  "c.button.default-fill": { "$value": "{color.bg-control}", "$description": "The outline button: bg-popover; --input at 32% in dark" },
  "c.button.default-edge": { "$value": "{color.border-control}", "$description": "border-input" },
  "c.field.size-xs": { "$value": "1.75rem", "$description": "sm input: 28 px with its border" },
  "c.field.size-s": { "$value": "2rem", "$description": "default input: h-7.5 plus a 1 px border, 32 px" },
  "c.field.size": { "$value": "2.25rem", "$description": "lg input: 36 px" },
  "c.field.radius": { "$value": "0.625rem", "$description": "rounded-lg 10 px" },
  "c.field.padding-inline": { "$value": "0.6875rem", "$description": "px-[calc(--spacing(3)-1px)] 11 px" },
  "c.field.padding-inline-sm": { "$value": "0.5625rem", "$description": "sm: 9 px" },
  "c.segmented-control.size-s": { "$value": "2rem", "$description": "The tab list: 32 px" },
  "c.segmented-control.radius": { "$value": "0.625rem", "$description": "rounded-lg list, rounded-md items" },
  "c.segmented-control.inset": { "$value": "0.125rem", "$description": "p-0.5: 2 px around the items" },
  "c.segmented-control.raised-text": { "$value": "{color.text}", "$description": "The chosen item: text-foreground" },
  "c.tabs.radius": { "$value": "0.5rem", "$description": "rounded-md items" },
  "c.tabs.item-size-s": { "$value": "2rem", "$description": "32 px items" },
  "c.checkbox.radius": { "$value": "0.25rem", "$description": "rounded-[.25rem] 4 px" },
  "c.checkbox.border-width": { "$value": "1px", "$description": "border: 1 px" },
  "c.checkbox.box": { "$value": "1rem", "$description": "size-4: 16 px" },
  "c.switch.track-inline": { "$value": "1.875rem", "$description": "w-[calc(var(--thumb-size)*2-2px)]: 30 px" },
  "c.switch.track-block": { "$value": "1.125rem", "$description": "h-[calc(var(--thumb-size)+2px)]: 18 px" },
  "c.switch.thumb": { "$value": "1rem", "$description": "--thumb-size: 16 px" },
  "c.switch.thumb-inset": { "$value": "1px", "$description": "p-px" },
  "c.switch.off-border": { "$value": "transparent", "$description": "No edge: the off track is a fill (bg-input)" },
  "c.switch.off-fill": { "$value": "{color.border-control}", "$description": "bg-input: the off track is a filled pill" },
  "c.switch.off-thumb": { "$value": "{color.map.switch-handle}", "$description": "The thumb stays bg-background when off" },
  "c.badge.radius": { "$value": "0.375rem", "$description": "rounded-sm 6 px" },
  "c.badge.size": { "$value": "1.125rem", "$description": "h-4.5: 18 px" },
  "c.badge.padding-inline": { "$value": "0.1875rem", "$description": "px-[calc(--spacing(1)-1px)] 3 px" },
  "c.card.radius": { "$value": "1rem", "$description": "rounded-2xl 16 px" },
  "c.card.padding": { "$value": "1.5rem", "$description": "p-6" },
  "c.dialog.radius": { "$value": "1rem", "$description": "rounded-2xl 16 px" },
  "c.alert.radius": { "$value": "0.875rem", "$description": "rounded-xl 14 px" },
  "c.example.radius": { "$value": "0.875rem", "$description": "The docs' preview frame: rounded-xl 14 px" },
  "c.example.outline": { "$value": "{color.border}", "$description": "border: black 8%" },
  "c.example.toggle-fg": { "$value": "{color.text-muted}", "$description": "Show the code reads muted, as the docs' tabs" },
  "c.slider.thumb-fill": { "$value": "#ffffff", "$description": "The thumb is white with a ring of --primary" },
  "c.slider.track-fill": { "$value": "{color.bg-tint}", "$description": "bg-input track" },
  "c.slider.fill": { "$value": "{color.accent}", "$description": "bg-primary range" },
  "c.progress.bar-track": { "$value": "{color.bg-tint}", "$description": "bg-input track" }
}
