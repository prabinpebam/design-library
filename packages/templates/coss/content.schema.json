{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/templates/coss/content/1",
  "title": "Component library in coss ui's look content, version 1",
  "description": "Generated by npm run content:schemas from packages/templates/coss/types.ts: do not edit by hand. The core envelope; each file's record is $defs/record.{layout} (record.shared for the shared file).",
  "$ref": "https://design-library.local/core/content/1",
  "$defs": {
    "CossCategory": {
      "additionalProperties": false,
      "description": "A category of components (Actions, Inputs…): its in-page anchor, title, one line and its previews.",
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/$defs/CossExample"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "examples"
      ],
      "type": "object"
    },
    "CossDemo": {
      "description": "One demo the showcase knows how to draw; each is built from core components only.",
      "enum": [
        "button-variants",
        "button-sizes",
        "button-icons",
        "button-group",
        "menu",
        "input",
        "input-states",
        "number-field",
        "textarea",
        "select",
        "checkbox",
        "radio-group",
        "switch",
        "segmented-control",
        "slider",
        "badge",
        "chip",
        "progress",
        "skeleton",
        "tooltip",
        "avatar",
        "kbd",
        "typography",
        "alert",
        "empty",
        "card",
        "accordion",
        "tabs",
        "dialog",
        "sheet",
        "popover",
        "breadcrumb",
        "pagination",
        "table",
        "calendar",
        "statistic"
      ],
      "type": "string"
    },
    "CossExample": {
      "additionalProperties": false,
      "description": "One component's preview: what it is and the demo that shows its variants and states.",
      "properties": {
        "demo": {
          "$ref": "#/$defs/CossDemo"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "demo",
        "title",
        "description"
      ],
      "type": "object"
    },
    "CossGroup": {
      "additionalProperties": false,
      "description": "A kind of component (fundamentals or compounds) and its categories.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CossCategory"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "intro",
        "categories"
      ],
      "type": "object"
    },
    "CossRecord": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/CossGroup"
          },
          "type": "array"
        },
        "home": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "page": {
          "additionalProperties": false,
          "properties": {
            "lead": {
              "type": "string"
            },
            "navLabel": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "lead",
            "navLabel"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ],
          "type": "object"
        },
        "words": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The words inside the demos, by key.",
          "type": "object"
        }
      },
      "required": [
        "name",
        "home",
        "source",
        "page",
        "groups",
        "words"
      ],
      "type": "object"
    },
    "record.shared": {
      "$ref": "#/$defs/CossRecord"
    }
  }
}
