{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-library.local/core/template/1",
  "title": "Template manifest, version 1",
  "description": "A template (Q62, Q64): its layouts, the regions of each, its content schema and version, its pictures, and every custom part it adds, all inside its own folder and namespace.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "contentSchema",
    "contentVersion",
    "layouts",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The namespace: equals the folder's name; every custom name starts with it."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "contentSchema": {
      "type": "string",
      "const": "content.schema.json"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "shared": {
      "type": "string",
      "const": "content/shared.json"
    },
    "assets": {
      "type": "string",
      "const": "assets.json"
    },
    "home": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The template's home screen (Q67): listed first at the top level of the navigation, beside the sections, and stored at content/{home}.json. It keeps its place in its flow (the steps of that flow), but no group lists it."
    },
    "theme": {
      "type": "object",
      "properties": {
        "space": {
          "enum": [
            "compact",
            "normal",
            "loose",
            "extra-loose"
          ]
        },
        "shape": {
          "enum": [
            "sharp",
            "rounded",
            "soft",
            "super-soft"
          ]
        }
      },
      "additionalProperties": false
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layout"
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "fundamentals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "compounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "schema",
              "renders"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
              },
              "schema": {
                "type": "string",
                "pattern": "^#/\\$defs/"
              },
              "renders": {
                "type": "string",
                "description": "The component that draws it: a core name or the template's namespaced part."
              },
              "example": {
                "type": "object",
                "description": "A sample block of this type, valid against its schema: what stories, previews and authoring tools start from. Optional; the content check validates it.",
                "required": ["type"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "The template as a grouped hierarchy (Q66, Q67): sections, the flows in each, the screens of each flow in order. Every layout that isn't a state sits in exactly one flow. Groups hold 3–5 items (Q67): the top level (home, sections, own parts) and each section, where a flow of 3 or more screens is one item (a group, folder content/{section}/{flow}/) and a shorter flow's screens are items of the section (folder content/{section}/).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "flows"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "flows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "screens"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "description": "What the person gets done in this flow, in one sentence."
                },
                "screens": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "description": "Layout ids, in the order the person meets them."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[A-Z][A-Za-z0-9]*$",
          "description": "Namespaced: `conference.SponsorWall`."
        },
        "source": {
          "type": "string",
          "pattern": "^parts/(fundamentals|compounds|layouts)/[A-Z][A-Za-z0-9]*\\.tsx$"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "planned": {
          "const": true,
          "description": "Not built yet: listed on the library's overview only, with no content."
        },
        "component": {
          "type": "string",
          "description": "The layout component: a core layout (`SiteLayout`) or the template's own (`conference.SponsorsLayout`)."
        },
        "content": {
          "type": "string",
          "pattern": "^content/([a-z][a-z0-9-]*/){0,2}[a-z][a-z0-9-]*\\.json$"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "shared": {
                "const": true
              },
              "accepts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Block types allowed here; `*` for any registered type."
              }
            },
            "additionalProperties": false
          }
        },
        "docs": {
          "type": "object",
          "description": "What the library says about this layout: words only.",
          "properties": {
            "summary": {
              "type": "string"
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "region",
                  "holds",
                  "uses"
                ],
                "properties": {
                  "region": {
                    "type": "string"
                  },
                  "holds": {
                    "type": "string"
                  },
                  "uses": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "narrow": {
              "type": "string"
            },
            "try": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notBuilt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "stateOf": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "This layout is a state of another screen (wrong password, nothing found, sent): its title names the state; it sits in that screen's folder and shows on its page, not in the navigation."
        }
      },
      "additionalProperties": false,
      "if": {
        "not": {
          "required": [
            "planned"
          ]
        }
      },
      "then": {
        "required": [
          "component",
          "content",
          "regions"
        ]
      }
    }
  }
}
